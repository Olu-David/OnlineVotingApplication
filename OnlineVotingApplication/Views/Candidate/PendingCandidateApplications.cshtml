@using OnlineVotingApplication.DataTransferView;
@model PaginatedListViewModel<PendingApplicationViewModel>

@{
    ViewData["Title"] = "Pending Candidate Applications Queue";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Pending Candidate Applications</h2>
            <p class="text-muted">Review voter interest submissions and dispatch secure registration invitations.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="py-3 ps-4">Applicant Name</th>
                            <th class="py-3">Email Address</th>
                            <th class="py-3">Election Event</th>
                            <th class="py-3">Position Applied</th>
                            <th class="py-3">Date Submitted</th>
                            <th class="py-3 text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@item.CandidateName</td>
                                    <td>
                                        <a href="mailto:@item.CandidateEmail" class="text-decoration-none text-primary">
                                            @item.CandidateEmail
                                        </a>
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark">@item.ElectionTitle</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            @item.PositionName
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        @item.CreatedAt.ToString("MMM dd, yyyy - HH:mm")
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- Form targeting the SendCandidateInvite action in CandidateController -->
                                        <form asp-controller="Candidate" asp-action="SendCandidateInvite" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <!-- Hidden Inputs to pass required context securely -->
                                            <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                            <input type="hidden" name="ElectionEventId" value="@item.ElectionEventId" />
                                            <input type="hidden" name="CandidateEmail" value="@item.CandidateEmail" />

                                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold shadow-sm">
                                                <i class="fas fa-paper-plane me-1"></i> Send Invite
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x d-block mb-3 text-black-50"></i>
                                    <p class="mb-0">No pending candidate applications found in the queue for this organization.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginated Footer Pagination Navigation Controls -->
        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center border-top">
                <span class="text-muted small">
                    Showing page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong> (Total Items: @Model.TotalItems)
                </span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link rounded-start" asp-action="PendingApplications" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" asp-action="PendingApplications" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link rounded-end" asp-action="PendingApplications" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>