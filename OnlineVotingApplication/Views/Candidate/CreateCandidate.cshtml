@model OnlineVotingApplication.DataTransferView.CandidateViewModel

@{
    ViewData["Title"] = "Create Candidate";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Form Wrapped in a Bootstrap Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create New Candidate</h4>
                </div>
                
                    <form asp-action="CreateCandidate" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger align-middle"></div>

                        <!-- Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Candidate Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Position Dropdown -->
                        <div class="mb-3">
                            <label asp-for="PositionId" class="form-label fw-bold">Position</label>
                            <select asp-for="PositionId" class="form-select" asp-items="ViewBag.PositionView">
                                <option value="">-- Select Position --</option>
                            </select>
                            <span asp-validation-for="PositionId" class="text-danger"></span>
                        </div>

                        <!-- State Dropdown -->
                        <div class="mb-3">
                            <label asp-for="StateId" class="form-label fw-bold">State</label>
                            <select asp-for="StateId" id="stateDropdown" class="form-select" asp-items="ViewBag.StateView">
                                <option value="">-- Select State --</option>
                            </select>
                            <span asp-validation-for="StateId" class="text-danger"></span>
                        </div>

                        <!-- LGA Dropdown -->
                        <div class="mb-3">
                            <label asp-for="LgaId" class="form-label fw-bold">LGA</label>
                            <select asp-for="LgaId" id="lgaDropdown" class="form-select" asp-items="ViewBag.Lga">
                                <option value="">-- Select LGA --</option>
                            </select>
                            <span asp-validation-for="LgaId" class="text-danger"></span>
                        </div>

                        <!-- Manifesto -->
                        <div class="mb-3">
                            <label asp-for="Manifesto" class="form-label fw-bold">Manifesto</label>
                            <textarea asp-for="Manifesto" class="form-control" rows="4" placeholder="Enter candidate's manifesto..."></textarea>
                            <span asp-validation-for="Manifesto" class="text-danger"></span>
                        </div>

                        <!-- Party Dropdown Menu -->
                        <div class="mb-3">
                            <label asp-for="PartyId" class="form-label fw-bold">Political Party</label>
                            <select asp-for="PartyId" class="form-select" asp-items="ViewBag.PartyView">
                                <option value="">-- Select Political Party --</option>
                            </select>
                            <span asp-validation-for="PartyId" class="text-danger"></span>
                        </div>


                        <!-- Candidate Image Upload -->
                        <div class="mb-4">
                            <label asp-for="CandidateImageUrl" class="form-label fw-bold">Candidate Photo</label>
                            <input asp-for="CandidateImageUrl" type="file" class="form-control" />
                            <span asp-validation-for="CandidateImageUrl" class="text-danger"></span>
                        </div>

                        <!-- Action Buttons Inside Card Footer Area -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                            <a asp-action="Index" class="btn btn-light me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create Candidate</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('stateDropdown').addEventListener('change', function () {
            var stateId = this.value;
            var lgaDropdown = document.getElementById('lgaDropdown');

            lgaDropdown.innerHTML = '<option value="">-- Select LGA --</option>';

            if (!stateId) return;

            var url = '@Url.Action("GetLgasByState", "Candidate")?stateId=' + stateId;

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    data.forEach(lga => {
                        var option = document.createElement('option');
                        option.value = lga.id;
                        option.textContent = lga.name;
                        lgaDropdown.appendChild(option);
                    });
                })
                .catch(error => console.error('Error loading LGAs:', error));
        });
    </script>
}
