@{
    ViewData["Title"] = "Approval Pending";
    Layout = "_Layout"; // Or your main layout file path
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm p-4 border-0 rounded-4">
                <div class="card-body">
                    <!-- Status Icon / Graphic -->
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-15 text-warning rounded-circle" style="width: 80px; height: 80px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-hourglass-split" viewBox="0 0 16 16">
                                <path d="M2.5 15a.5.5 0 1 1 0-1h1v-1a4.5 4.5 0 0 1 2.558-4.06c.29-.139.443-.377.443-.59v-.7c0-.213-.154-.451-.443-.59A4.5 4.5 0 0 1 3.5 3V2h-1a.5.5 0 0 1 0-1h11a.5.5 0 0 1 0 1h-1v1a4.5 4.5 0 0 1-2.558 4.06c-.29.139-.443.377-.443.59v.7c0 .213.154.451.443.59A4.5 4.5 0 0 1 12.5 13v1h1a.5.5 0 0 1 0 1zm2-13v1a3.5 3.5 0 0 0 1.989 3.158c.533.256 1.011.791 1.011 1.442v.7c0 .651-.478 1.186-1.011 1.442A3.5 3.5 0 0 0 4.5 13v1h7v-1a3.5 3.5 0 0 0-1.989-3.158C8.978 9.586 8.5 9.051 8.5 8.4v-.7c0-.651.478-1.186 1.011-1.442A3.5 3.5 0 0 0 11.5 3V2z" />
                            </svg>
                        </div>
                    </div>

                    <!-- Notification Heading -->
                    <h2 class="card-title fw-bold mb-3">Email Verified Successfully!</h2>

                    <p class="text-muted mb-4">
                        Thank you for confirming your email address. Your organization and administrator profile have been provisioned and are currently <strong class="text-dark">pending review</strong> by the platform administrator.
                    </p>

                    <div class="alert alert-light border text-start p-3 mb-4 small text-secondary">
                        <span class="fw-semibold">What happens next?</span><br>
                        Once an administrator reviews and approves your organization details, your account will be activated, and you'll have full access to set up your elections.
                    </div>

                    <!-- Action Button -->
                    <a href="@Url.Action("Login", "Auth")" class="btn btn-primary w-100 py-2 fw-semibold">Return to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>