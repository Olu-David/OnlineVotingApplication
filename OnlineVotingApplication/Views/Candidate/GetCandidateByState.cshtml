@using OnlineVotingApplication.DataTransferView
@model PaginatedListViewModel<CandidateViewModel>

@{
    ViewData["Title"] = "Constituency Filter";
    Layout = "_Layout";

    int startItem = ((Model.PageNumber - 1) * Model.PageSize) + 1;
    int endItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems);
    if (Model.TotalItems == 0) { startItem = 0; endItem = 0; }
}

@section Styles {
    <link rel="stylesheet" href="/css/candidate.css" asp-append-version="true" />
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FILTER BAR -->
    <div class="card candmgmt-filter-bar mb-4">
        <div class="card-body p-4">
            <form asp-action="GetCandidateByState" method="get" class="row g-3 align-items-center">
                <input type="hidden" name="pageNumber" value="1" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <div class="col-md-5">
                    <label class="form-label">State / Region</label>
                    <select name="stateId" asp-items="ViewBag.States" class="form-select">
                        <option value="">-- Select State --</option>
                    </select>
                </div>

                <div class="col-md-3 align-self-end">
                    <button type="submit" class="btn candmgmt-filter-btn px-4 shadow-sm">
                        <i class="bi bi-funnel-fill me-1"></i> Apply Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- RESULTS -->
    <div class="card candmgmt-card">
        <div class="candmgmt-header">
            <h5>
                <i class="bi bi-geo-alt-fill me-2"></i>
                @(!string.IsNullOrEmpty(ViewBag.SelectedStateName) ? $"Candidates in {ViewBag.SelectedStateName}" : "Candidates by State")
            </h5>
            <span class="badge">@Model.TotalItems Total</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-folder-x display-4 d-block mb-3 text-secondary"></i>
                    <h5 class="fw-medium text-dark mb-1">No candidates found</h5>
                    <p class="small text-muted mb-0">Select a state above to filter the directory.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th scope="col" class="ps-3" style="width: 70px;">Profile</th>
                                <th scope="col">Candidate</th>
                                <th scope="col">Party</th>
                                <th scope="col">Position</th>
                                <th scope="col">State</th>
                                <th scope="col" class="text-center" style="width: 240px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <img src="@(string.IsNullOrEmpty(item.image) ? "/images/default-avatar.png" : item.image)"
                                             alt="@item.Name" class="candmgmt-avatar" />
                                    </td>

                                    <td>
                                        <div class="candmgmt-name">@item.Name</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 260px;">
                                            @(string.IsNullOrEmpty(item.Manifesto) ? "No manifesto provided." : item.Manifesto)
                                        </small>
                                    </td>

                                    <td><span class="badge candmgmt-party-badge">@item.PartyName</span></td>
                                    <td><span class="text-secondary fw-semibold small">@item.Position</span></td>
                                    <td><i class="bi bi-geo-alt text-muted small me-1"></i>@item.StateName</td>

                                    <td class="pe-3">
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.CandidateID"
                                               class="btn btn-outline-warning btn-sm d-flex align-items-center justify-content-center gap-1 flex-grow-1 fw-medium">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>

                                            <form asp-action="ConfirmSoftDelete" method="post" class="m-0 flex-grow-1"
                                                  onsubmit="return confirm('⚠️ SOFT-DELETE CONFIRMATION:\n\nAre you sure you want to transfer @item.Name to the trash bin directory system?');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="candidateId" value="@item.CandidateID" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-1 fw-medium">
                                                    <i class="bi bi-trash3-fill"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card-footer bg-white p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center border-top">
            <div class="text-muted small mb-2 mb-sm-0">
                Showing <strong>@startItem</strong> to <strong>@endItem</strong> of <strong>@Model.TotalItems</strong>
                <span class="mx-1 text-muted">|</span> Page @Model.PageNumber of @Model.TotalPages
            </div>

            <nav aria-label="Candidates directory page navigation">
                <ul class="pagination pagination-sm mb-0 shadow-sm">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link px-3 fw-medium"
                           asp-action="GetCandidateByState"
                           asp-route-stateId="@ViewBag.SelectedStateId"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            &laquo; Previous
                        </a>
                    </li>

                    <li class="page-item active">
                        <span class="page-link fw-bold px-3">@Model.PageNumber</span>
                    </li>

                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link px-3 fw-medium"
                           asp-action="GetCandidateByState"
                           asp-route-stateId="@ViewBag.SelectedStateId"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>
