@using OnlineVotingApplication.DataTransferView;
@model PaginatedListViewModel<PositionDTO>;

@{
    ViewData["Title"] = "AllSoftDelete";
    Layout = "_Layout";
}

<div class=" container mt-4">
    @* @Html.PartialAsync("_Alerts"); *@
    <div class="card border-0 rounded-3 shadow-sm">
        <div class=" card-header align-items-center justify-content-center">
            <h5 class="p-4 fw-bold">
                <i class="fi-f-crown"></i>
                <span>AllSoftDelete</span>
            </h5>
            <div class="card-body m-0 p-4">
                @if((Model.Items==null)|| !Model.Items.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-folder-x display-5 d-block mb-2"></i>
                        <span>No active records found for this page window index.</span>
                    </div>
                }
                else
                {
                    <div class=" table-responsive">
                        <table class="table-hover  align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr >
                                    <th scope="col" >Positon Name</th>
                                    <th scope="col">Election Title</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td >
                                            <div class="fw-bold text-dark">@item.Name</div>
                                        </td>

                                        <td>
                                            @if (ViewBag.SoftPositionDeletedByElection!=null)
                                            {
                                                <div class="fw-bold text-dark">@ViewBag.SoftPositionDeletedByElection</div>
                                            }
                                        </td>
                                        <td class="pe-3">
                                            <div class="align-items-center justify-content-center ">
                                                <a asp-controller="Positon" asp-route="EditPosition" class="btn-outline-warning btn-sm d-flex align-items-center justify-content-center gap-1 flex-grow-1">
                                                    <i class="bi bi-pencil-square"></i> Edit
                                                </a>
                                                @* <!-- SOFT-DELETE ACTION FORM -->
                                                <form asp-action="Restore " method="post" class="m-0 flex-grow-1"
                                                      onsubmit="return confirm('⚠️ SOFT-DELETE CONFIRMATION:\n\nAre you sure you want to move @item.Name to the Trash Bin?\n\nYou will have 30 days to restore this profile before it is automatically destroyed.');">
                                                    @Html.AntiForgeryToken()

                                                    <!-- Hidden configuration mappings directly tied to pagination properties -->
                                                    <input type="hidden" name="candidateId" value="@item.Id" />
                                                    <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-1">
                                                        <i class="bi bi-trash3-fill"></i> Delete
                                                    </button>
                                                </form> *@

                                            </div>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                        
                    </div>
                }

            </div>
        </div>
    </div>
</div>