<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Voting Portal</title>

    <!-- Bootstrap & Font Awesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Voters CSS -->
    <link href="~/Content/css/voters.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- TOP NAVBAR -->
    <nav class="voters-navbar">
        <div class="navbar-container">
            <div class="navbar-brand">
                <i class="fas fa-vote-yea"></i>
                <span>Voting Portal</span>
            </div>

            <ul class="navbar-menu">
                <li><a href="/Voters/Dashboard">Home</a></li>
                <li><a href="/Voters/Elections">Elections</a></li>
                <li><a href="/Voters/MyVotes">My Votes</a></li>
                <li><a href="/Voters/Results">Results</a></li>
            </ul>

            <div class="navbar-user">
                <span>@User?.Identity?.Name</span>
                <a href="/Account/Logout" class="btn-logout">Logout</a>
            </div>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main class="voters-main">
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="voters-footer">
        <p>&copy; @DateTime.Now.Year Online Voting System. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/layouts/voters.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
