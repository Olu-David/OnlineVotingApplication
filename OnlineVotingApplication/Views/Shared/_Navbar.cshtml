@{
    Layout = null;
}
@using Microsoft.AspNetCore.Identity
@using OnlineVotingApplication.Areas.Identity.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    bool isAuth = User.Identity?.IsAuthenticated ?? false;
    bool isBlocked = ViewData["IsBlocked"] as bool? ?? false;

    // Dynamic Role checks from claims/User principal
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool isOfficial = User.IsInRole("Official");
    bool isVoter = User.IsInRole("Voter");
    bool isCandidate = User.IsInRole("Candidate");
    bool isAuditor = User.IsInRole("Auditor");

    // Determine dashboard redirection based on primary role
    string dashCtrl = "Home";
    if (isSuperAdmin) dashCtrl = "SuperAdminDashboard";
    else if (isOfficial) dashCtrl = "Tenant";
    else if (isCandidate) dashCtrl = "Candidate";
    else if (isAuditor) dashCtrl = "Auditor";
    else if (isVoter) dashCtrl = "Voter";

    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string roleBadge = isSuperAdmin ? "Super Admin" :
                       isOfficial ? "Official" :
                       isCandidate ? "Candidate" :
                       isAuditor ? "Auditor" :
                       isVoter ? "Voter" : "User";

    string roleBadgeClass = isSuperAdmin ? "role-badge--superadmin" :
                            isOfficial ? "role-badge--official" :
                            isCandidate ? "role-badge--candidate" :
                            isAuditor ? "role-badge--auditor" :
                            isVoter ? "role-badge--voter" : "role-badge--guest";

    string userName = User.Identity?.Name ?? "User";
    string nameInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "?";
}

<nav class="navbar navbar-expand-lg navbar-dark votezy-navbar sticky-top shadow-sm">
    <div class="container py-1">

        <!-- Brand Logo -->
        <a asp-controller="@(isAuth && !isBlocked ? dashCtrl : "Home")" asp-action="Index" class="navbar-brand fw-bold d-flex align-items-center gap-2">
            <div class="brand-logo-badge shadow-sm">
                <i class="fas fa-vote-yea text-dark"></i>
            </div>
            <span class="fs-4 tracking-wide text-white">Vote<span class="text-warning">zy</span></span>
        </a>

        <!-- Mobile Toggle Button -->
        <button class="navbar-toggler border-0 shadow-none px-2 py-1" type="button"
                data-bs-toggle="collapse" data-bs-target="#mainNavMenu"
                aria-controls="mainNavMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1 ms-lg-3">

                <!-- Home Link: Only shown to guests/unauthenticated users -->
                @if (!isAuth || isBlocked)
                {
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index"
                           class="nav-link px-2.5 py-1 rounded-pill transition-all @(ctrl == "Home" && action == "Index" ? "active shadow-xs" : "")">
                            <i class="fas fa-home me-1 text-warning opacity-75"></i> Home
                        </a>
                    </li>
                }

                @if (isAuth && !isBlocked)
                {
                    @if (!isCandidate)
                    {
                        <li class="nav-item">
                            <a asp-controller="@dashCtrl" asp-action="Index"
                               class="nav-link px-2.5 py-1 rounded-pill transition-all @(ctrl == dashCtrl && action == "Index" ? "active shadow-xs" : "")">
                                <i class="fas fa-tachometer-alt me-1 text-info opacity-75"></i> Dashboard
                            </a>
                        </li>
                    }

                    @if (isVoter)
                    {
                        <li class="nav-item">
                            <a asp-controller="Voter" asp-action="MyHistory"
                               class="nav-link px-2.5 py-1 rounded-pill transition-all @(ctrl == "Voter" && action == "MyHistory" ? "active shadow-xs" : "")">
                                <i class="fas fa-history me-1 text-success opacity-75"></i> My Ballots
                            </a>
                        </li>
                    }

                    @if (isCandidate)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-2.5 py-1 rounded-pill @(ctrl == "Candidate" || (ctrl == "Voter" && (action == "BallotBreakdown" || action == "LiveResults")) ? "active" : "")"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-tie me-1 text-warning"></i> Campaign
                            </a>
                            <ul class="dropdown-menu border-0 shadow-lg mt-2 rounded-4 p-2 animate-dropdown">
                                <li>
                                    <a asp-controller="Candidate" asp-action="Index" class="dropdown-item rounded-2 py-2 @(ctrl == "Candidate" && action == "Index" ? "active bg-light text-dark fw-bold" : "")">
                                        <i class="fas fa-home me-2 text-primary"></i> Overview
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Voter" asp-action="BallotBreakdown" class="dropdown-item rounded-2 py-2 @(ctrl == "Voter" && action == "BallotBreakdown" ? "active bg-light text-dark fw-bold" : "")">
                                        <i class="fas fa-vote-yea me-2 text-warning"></i> Ballot Breakdown
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1 opacity-25" /></li>
                                <li>
                                    <a asp-controller="Voter" asp-action="LiveResults" class="dropdown-item rounded-2 py-2 @(ctrl == "Voter" && action == "LiveResults" ? "active bg-light text-dark fw-bold" : "")">
                                        <span class="spinner-grow spinner-grow-sm me-2 text-danger" role="status" style="width: 6px; height: 6px;"></span> Live Results
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    @if (isAuditor)
                    {
                        <li class="nav-item">
                            <a asp-controller="Auditor" asp-action="Logs"
                               class="nav-link px-2.5 py-1 rounded-pill transition-all @(ctrl == "Auditor" && action == "Logs" ? "active shadow-xs" : "")">
                                <i class="fas fa-file-alt me-1 text-danger opacity-75"></i> Audit Logs
                            </a>
                        </li>
                    }

                    @if (!isCandidate)
                    {
                        <li class="nav-item">
                            <a asp-controller="Voter" asp-action="LiveResults"
                               class="nav-link px-2.5 py-1 rounded-pill transition-all @(ctrl == "Voter" && action == "LiveResults" ? "active shadow-xs" : "")">
                                <span class="spinner-grow spinner-grow-sm me-1 text-danger" role="status" style="width: 6px; height: 6px;"></span> Live Results
                            </a>
                        </li>
                    }
                }

                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Privacy"
                       class="nav-link px-2.5 py-1 rounded-pill transition-all text-white-50 @(ctrl == "Home" && action == "Privacy" ? "active text-white" : "")">
                        Privacy
                    </a>
                </li>
            </ul>

            <!-- Right side: User Profile & Authentication actions -->
            <div class="d-flex align-items-center gap-3 pt-3 pt-lg-0 border-top border-light border-opacity-10">
                @if (isAuth && SignInManager.IsSignedIn(User))
                {
                    <span class="badge @roleBadgeClass px-2.5 py-1.5 rounded-pill fw-semibold shadow-sm text-xs">
                        <i class="fas fa-shield-alt me-1 small"></i> @roleBadge
                    </span>

                    <div class="dropdown">
                        <button class="btn user-menu-btn d-flex align-items-center gap-2 dropdown-toggle border-0 rounded-pill px-2 py-1"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar-sm rounded-circle bg-warning text-dark fw-bold d-inline-flex align-items-center justify-content-center shadow-sm" style="width:30px; height:30px; font-size: 0.8rem;">
                                @nameInitial
                            </span>
                            <span class="d-none d-lg-inline small fw-semibold text-white">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-mobile-fix dropdown-menu-end border-0 shadow-lg mt-2 rounded-4 p-2 animate-dropdown" style="min-width: 220px;">
                            <li>
                                <div class="dropdown-item-text py-2 bg-light bg-opacity-10 rounded-3 mb-2">
                                    <div class="fw-bold small text-dark text-truncate">@userName</div>
                                    <small class="text-muted text-uppercase tracking-wider" style="font-size: 0.65rem;">Role: @roleBadge</small>
                                </div>
                            </li>
                            <li><a asp-controller="@dashCtrl" asp-action="Index" class="dropdown-item rounded-2 py-2"><i class="fas fa-tachometer-alt me-2 text-primary"></i> Dashboard</a></li>

                            @if (isVoter)
                            {
                                <li><a asp-controller="Voter" asp-action="Profile" class="dropdown-item rounded-2 py-2"><i class="fas fa-user-circle me-2 text-info"></i> Voter Profile</a></li>
                            }
                            @if (isCandidate)
                            {
                                <li><a asp-controller="Candidate" asp-action="Index" class="dropdown-item rounded-2 py-2"><i class="fas fa-user-tie me-2 text-warning"></i> Candidate Portal</a></li>
                            }

                            <li><hr class="dropdown-divider my-1 opacity-25" /></li>
                            <li>
                                <form asp-controller="AuthService" asp-action="LogoutUser" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger rounded-2 py-2 fw-semibold">
                                        <i class="fas fa-sign-out-alt me-2"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 w-100">
                        <a asp-action="Login" asp-controller="AuthService" class="btn btn-outline-light btn-sm px-3 rounded-pill fw-semibold">Sign In</a>
                        <a asp-action="UserRegistration" asp-controller="AuthService" class="btn btn-warning btn-sm fw-bold text-dark px-3 rounded-pill shadow-sm">Register</a>
                    </div>
                }
            </div>
        </div>
    </div>
</nav>

<style>
    .votezy-navbar {
        background: linear-gradient(135deg, #101d35 0%, #1a2e5a 100%);
        border-bottom: 3px solid #f5a623;
        backdrop-filter: blur(10px);
    }

    .brand-logo-badge {
        width: 34px;
        height: 34px;
        background: #f5a623;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .votezy-navbar .nav-link {
        color: rgba(255, 255, 255, 0.8) !important;
        font-weight: 500;
        font-size: 0.875rem;
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
        padding-top: 0.35rem !important;
        padding-bottom: 0.35rem !important;
        transition: all 0.2s ease;
    }

        .votezy-navbar .nav-link:hover,
        .votezy-navbar .nav-link:focus {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.08);
        }

        .votezy-navbar .nav-link.active {
            background-color: #f5a623 !important;
            color: #101d35 !important;
            font-weight: 600;
        }

            .votezy-navbar .nav-link.active i {
                color: #101d35 !important;
            }

    .user-menu-btn {
        background-color: rgba(255, 255, 255, 0.05);
        transition: background-color 0.2s ease;
    }

        .user-menu-btn:hover {
            background-color: rgba(255, 255, 255, 0.12);
        }

    .animate-dropdown {
        animation: fadeInDropdown 0.2s ease-in-out;
    }

    @@media (max-width: 991.98px) {
        .dropdown-menu-mobile-fix

    {
        position: absolute !important;
        right: 0 !important;
        left: auto !important;
        transform: none !important;
        float: none !important;
    }

    }

    @@keyframes fadeInDropdown {
        from

    {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>