{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}",
    "RedisConnection": "${ConnectionStrings__RedisConnection}"
  },
  "Resend": {
    "ApiKey": "${Resend__ApiKey}"
  },
  "Supabase": {
    "Url": "${Supabase__Url}",
    "ServiceRoleKey": "${Supabase__ServiceRoleKey}"
  },
  "Authentication": {
    "Google": {
      "ClientId": "${Authentication__Google__ClientId}",
      "ClientSecret": "${Authentication__Google__ClientSecret}"
    }
  }
}