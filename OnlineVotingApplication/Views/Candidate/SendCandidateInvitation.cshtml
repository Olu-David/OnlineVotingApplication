@model OnlineVotingApplication.DataTransferView.SendCandidateInvitation 

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Send Candidate Invitation</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Candidate" asp-action="SendCandidateInvite" method="post">
            @Html.AntiForgeryToken()

            <!-- Pass the target election ID -->
            <input type="hidden" name="electionEventId" value="@Model.ElectionEventId" />

            <div class="mb-3">
                <label for="candidateEmail" class="form-label">Candidate Email Address</label>
                <input type="email" class="form-control" id="candidateEmail" name="candidateEmail" placeholder="candidate@example.com" required />
            </div>

            <button type="submit" class="btn btn-success">
                <i class="bi bi-envelope-paper"></i> Send Secure Invitation Link
            </button>
        </form>
    </div>
</div>