@using OnlineVotingApplication.Enums
@using OnlineVotingApplication.Models
@model OnlineVotingApplication.DataTransferView.CandidateViewModel

@{
    ViewData["Title"] = "Create Candidate Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/candidate.css" asp-append-version="true" />
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header candform-header p-3">
            <h4 class="mb-0">
                <i class="fas fa-user-plus me-2" style="color: var(--votex-amber, #ffb703);"></i>
                Create Candidate for @Model.LockedElectionTitle
            </h4>
        </div>

        <div class="card-body p-4">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="CreateCandidate" method="post" enctype="multipart/form-data" id="candidateForm">
                @Html.AntiForgeryToken()

                <!-- ═══ Server-locked hidden fields ═══ -->
                <input type="hidden" asp-for="ElectionEventId" />
                <input type="hidden" asp-for="PositionId" />
                <input type="hidden" asp-for="Name" value="@Model.LockedName" />
                <input type="hidden" name="token" value="@ViewBag.InviteToken" />

                <!-- ═══════════════════════════════════════════════
                     LOCKED FIELDS (read-only display)
                     ═══════════════════════════════════════════════ -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Candidate Full Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control bg-light"
                               value="@Model.LockedName"
                               readonly
                               tabindex="-1"
                               aria-readonly="true" />
                        <small class="text-muted d-block mt-1">
                            <i class="fas fa-lock me-1"></i> Locked to your account name.
                        </small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Position <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control bg-light"
                               value="@Model.LockedPositionName"
                               readonly
                               tabindex="-1"
                               aria-readonly="true" />
                        <small class="text-muted d-block mt-1">
                            <i class="fas fa-lock me-1"></i> Locked to the position on your invitation.
                        </small>
                    </div>
                </div>

                <!-- ═══════════════════════════════════════════════
                     POLITICAL-ONLY FIELDS
                     ═══════════════════════════════════════════════ -->
                @if (Model.IsPolitical)
                {
                    <div class="row">
                        <!-- Party -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyId" class="form-label fw-bold">
                                Political Party <span class="text-danger">*</span>
                            </label>
                            <select asp-for="PartyId" asp-items="Model.Parties" class="form-select">
                                <option value="">-- Select Party --</option>
                            </select>
                            <span asp-validation-for="PartyId" class="text-danger small"></span>
                        </div>

                        <!-- State -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="StateId" class="form-label fw-bold">State</label>
                            <select asp-for="StateId"
                                    id="stateDropdown"
                                    asp-items="Model.States"
                                    class="form-select"
                                    data-selected="@Model.StateId">
                                <option value="">-- Select State --</option>
                            </select>
                            <span asp-validation-for="StateId" class="text-danger small"></span>
                        </div>

                        <!-- LGA -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="LgaId" class="form-label fw-bold">LGA</label>
                            <select asp-for="LgaId"
                                    id="lgaDropdown"
                                    asp-items="Model.Lga"
                                    class="form-select"
                                    data-selected="@Model.LgaId">
                                <option value="">-- Select LGA --</option>
                            </select>
                            <span asp-validation-for="LgaId" class="text-danger small"></span>
                        </div>
                    </div>
                }

                <!-- ═══════════════════════════════════════════════
                     COMMON FIELDS
                     ═══════════════════════════════════════════════ -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CandidateImageUrl" class="form-label fw-bold">
                            Candidate Profile Picture
                        </label>
                        <input asp-for="CandidateImageUrl" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="CandidateImageUrl" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Manifesto" class="form-label fw-bold">Manifesto</label>
                    <textarea asp-for="Manifesto"
                              class="form-control"
                              rows="4"
                              placeholder="Enter candidate's vision or campaign goals..."></textarea>
                    <span asp-validation-for="Manifesto" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GalleryPhotos" class="form-label fw-bold">Gallery Photos (Optional)</label>
                    <input asp-for="GalleryPhotos" type="file" class="form-control" multiple accept="image/*" />
                    <span asp-validation-for="GalleryPhotos" class="text-danger small"></span>
                </div>

                <!-- ═══════════════════════════════════════════════
                     DYNAMIC CUSTOM FIELDS
                     ═══════════════════════════════════════════════ -->
                @if (Model.CustomFields.Any())
                {
                    <hr class="my-4 text-muted" />
                    <h5 class="mb-3 fw-bold" style="color: var(--votex-navy-900, #0a192f);">
                        <i class="fas fa-clipboard-question me-2" style="color: var(--votex-amber, #ffb703);"></i>
                        Additional Information
                    </h5>

                    <div class="row">
                        @foreach (var field in Model.CustomFields)
                        {
                            var existingVal = Model.DynamicAnswers != null && Model.DynamicAnswers.ContainsKey(field.Id)
                            ? Model.DynamicAnswers[field.Id]
                            : string.Empty;

                            var fieldKey = field.Id.ToString();

                            <div class="col-12 mb-3" data-field-container="@fieldKey">
                                <label class="form-label fw-semibold">
                                    @field.FieldName
                                    @if (field.IsRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>

                                @switch (field.FieldType)
                                {
                                    case ElectionFieldType.Dropdown:
                                        var options = !string.IsNullOrEmpty(field.CustomChoicesCsv)
                                        ? field.CustomChoicesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                        : Array.Empty<string>();
                                        <select name="DynamicAnswers[@(fieldKey)]" class="form-select" required="@(field.IsRequired ? "required" : null)">
                                            <option value="">-- Select @field.FieldName --</option>
                                            @foreach (var opt in options)
                                            {
                                                var trimmed = opt.Trim();
                                                <option value="@trimmed" selected="@(existingVal == trimmed)">@trimmed</option>
                                            }
                                        </select>
                                        break;

                                    case ElectionFieldType.StateDropdown:
                                        <select name="DynamicAnswers[@(fieldKey)]"
                                                class="form-select dynamic-state-select"
                                                data-linked-lga="@fieldKey"
                                                required="@(field.IsRequired ? "required" : null)">
                                            <option value="">-- Select State --</option>
                                            @foreach (var s in Model.States!)
                                            {
                                                <option value="@s.Value" selected="@(existingVal == s.Value)">@s.Text</option>
                                            }
                                        </select>
                                        break;

                                    case ElectionFieldType.LgaDropdown:
                                        <select name="DynamicAnswers[@(fieldKey)]"
                                                class="form-select dynamic-lga-select"
                                                data-parent-state="@fieldKey"
                                                required="@(field.IsRequired ? "required" : null)">
                                            <option value="">-- Select LGA --</option>
                                        </select>
                                        break;

                                    case ElectionFieldType.File:
                                        <input type="file"
                                               name="DynamicFiles[@(fieldKey)]"
                                               class="form-control"
                                               required="@(field.IsRequired ? "required" : null)" />
                                        <span class="form-text text-muted">Upload required attachment or credential document.</span>
                                        break;

                                    case ElectionFieldType.TextArea:
                                        <textarea name="DynamicAnswers[@(fieldKey)]"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Provide answer..."
                                  required="@(field.IsRequired ? "required" : null)">@existingVal</textarea>
                                        break;

                                    case ElectionFieldType.Input:
                                    default:
                                        <input type="text"
                                               name="DynamicAnswers[@(fieldKey)]"
                                               value="@existingVal"
                                               class="form-control"
                                               placeholder="Provide answer..."
                                               required="@(field.IsRequired ? "required" : null)" />
                                        break;
                                }

                                @Html.ValidationMessage($"DynamicAnswers[{fieldKey}]", new { @class = "text-danger small" })
                            </div>
                        }
                    </div>
                }

                <!-- ═══ Actions ═══ -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Candidate" asp-action="PendingCandidateApplications"
                       class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn candform-submit px-4">
                        <i class="fas fa-save me-1"></i> Create Candidate
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            // ─────────────────────────────────────────────
            // Helper: load LGAs for a given state
            // ─────────────────────────────────────────────
            function loadLgas(stateId, $lgaTarget, preselectedLga) {
                $lgaTarget.empty().append('<option value="">-- Select LGA --</option>');
                if (!stateId) return;

                $.ajax({
                    url: '/Candidate/GetLgasByState',
                    type: 'GET',
                    data: { stateId: stateId },
                    dataType: 'json'
                })
                .done(function (data) {
                    $.each(data, function (_, item) {
                        var id = item.id || item.Id;
                        var name = item.name || item.Name;
                        var isSelected = preselectedLga && String(id) === String(preselectedLga);
                        $lgaTarget.append(new Option(name, id, false, isSelected));
                    });
                })
                .fail(function (xhr) {
                    console.error("Failed to load LGAs:", xhr.status, xhr.responseText);
                });
            }

            // ─────────────────────────────────────────────
            // Standard State → LGA cascade
            // ─────────────────────────────────────────────
            var $state = $('#stateDropdown');
            var $lga = $('#lgaDropdown');

            if ($state.length && $state.val()) {
                loadLgas($state.val(), $lga, $lga.data('selected'));
            }

            $state.on('change', function () {
                loadLgas($(this).val(), $lga, null);
            });

            // ─────────────────────────────────────────────
            // Dynamic State → LGA cascade (custom fields)
            // ─────────────────────────────────────────────
            function findLinkedLgaSelect($stateSelect) {
                var container = $stateSelect.closest('[data-field-container]');
                var stateKey = container.data('field-container');
                return $('[data-parent-state="' + stateKey + '"]');
            }

            $('.dynamic-state-select').on('change', function () {
                var $s = $(this);
                var $target = findLinkedLgaSelect($s);
                if ($target.length === 0) return;
                loadLgas($s.val(), $target, null);
            });

            // Preselect LGA on page load for dynamic State fields
            $('.dynamic-state-select').each(function () {
                var $s = $(this);
                if ($s.val()) {
                    var $target = findLinkedLgaSelect($s);
                    if ($target.length) {
                        loadLgas($s.val(), $target, $target.data('selected'));
                    }
                }
            });
        });
    </script>
}