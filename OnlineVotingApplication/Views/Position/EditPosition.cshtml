@using OnlineVotingApplication.DataTransferView;
@model EditPositionModel;

@{
    ViewData["Title"] = "Edit Position";
    Layout = "_Layout";

}
<div class="container mt-4">
   <div class="row align-content-center">
       <div class="col-md-6">
            <h1 class="fw-bold text-muted mb-4">Edit Position</h1>
            <form action="EditPosition" method="post" class="card p-4 shadow-sm border-0 rounded-3">
               @Html.AntiForgeryToken()
               <input type="hidden" name="Id" @Model.Id/>
               <div  asp-validation-summary="ModelOnly"  class="text-danger mb-2 "></div>
               <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-medium">Position Name</label>
                    <input type="text" name="Name" asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
               </div>
               <div class="mb-4 d-flex gap-2">
                    <button class="btn btn-primary btn-lg flex-grow-1">
                    <i class="fas fa-save me-1"></i> Save Changes
                    </button>
                     <a asp-action="Index" class="btn btn-outline-secondary btn-lg"> </a>
                        <i class="fas fa-times me-1"></i> Cancel
               </div>
              

           </form>
       </div>
   </div>
</div>