<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Super Admin</title>

    <!-- Bootstrap & Font Awesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Super Admin CSS -->
    <link href="~/Content/css/superadmin.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="superadmin-container">
        <!-- SIDEBAR -->
        <aside class="superadmin-sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-crown"></i>
                <span>Super Admin</span>
            </div>

            <nav class="sidebar-menu">
                <p class="menu-label">SYSTEM</p>
                <a href="/SuperAdmin/Dashboard" class="menu-item">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
                <a href="/SuperAdmin/Elections" class="menu-item">
                    <i class="fas fa-calendar-alt"></i> Elections
                </a>
                <a href="/SuperAdmin/Candidates" class="menu-item">
                    <i class="fas fa-user-tie"></i> Candidates
                </a>
                <a href="/SuperAdmin/Voters" class="menu-item">
                    <i class="fas fa-users"></i> Voters
                </a>
                <a href="/SuperAdmin/Officials" class="menu-item">
                    <i class="fas fa-clipboard-list"></i> Officials
                </a>
                <a href="/SuperAdmin/Auditors" class="menu-item">
                    <i class="fas fa-search"></i> Auditors
                </a>

                <p class="menu-label">MANAGEMENT</p>
                <a href="/SuperAdmin/Reports" class="menu-item">
                    <i class="fas fa-chart-bar"></i> Reports
                </a>
                <a href="/SuperAdmin/Results" class="menu-item">
                    <i class="fas fa-poll"></i> Results
                </a>
                <a href="/SuperAdmin/Settings" class="menu-item">
                    <i class="fas fa-cog"></i> Settings
                </a>
                <a href="/SuperAdmin/Logs" class="menu-item">
                    <i class="fas fa-file-alt"></i> Audit Logs
                </a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="superadmin-main">
            <!-- TOP BAR -->
            <header class="superadmin-topbar">
                <button class="btn-toggle-sidebar" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <h2 class="page-title">@ViewBag.Title</h2>
                <div class="topbar-user">
                    <span><i class="fas fa-user-shield"></i> @User?.Identity?.Name</span>
                    <a href="/Account/Logout" class="btn btn-sm btn-logout">Logout</a>
                </div>
            </header>

            <!-- PAGE CONTENT -->
            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/layouts/superadmin.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
