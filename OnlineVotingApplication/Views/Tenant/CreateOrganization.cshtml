@using OnlineVotingApplication.Enums
@model OnlineVotingApplication.DataTransferView.TenantRegistrationViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Register Your Organization Workspace";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            <div class="text-center mb-4">
                <div class="avatar bg-primary text-white rounded-circle p-3 mx-auto mb-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                    <i class="fas fa-building fa-2x"></i>
                </div>
                <h1 class="h3 fw-bold text-dark">Workspace Provisioning Center</h1>
                <p class="text-muted">Initialize your multi-tenant secure election workspace footprint and primary administrator account credentials.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Tenant" asp-action="CreateOrganization" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- Global Master Error Notification Banner Summary Container -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small mb-4" role="alert"></div>

                        <h4 class="h5 fw-bold text-dark border-bottom pb-2 mb-4">
                            <i class="fas fa-layer-group text-primary me-2"></i>1. Corporate Workspace Configuration Details
                        </h4>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="OrganizationName" class="form-label small fw-bold text-secondary">Organization / Company Name</label>
                                <input asp-for="OrganizationName" type="text" class="form-control" placeholder="e.g. Abuja University, Lagos State Tech" required />
                                <span asp-validation-for="OrganizationName" class="text-danger xsmall"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TenantCategory" class="form-label small fw-bold text-secondary">Operational Sector Classification</label>
                                <select asp-for="TenantCategory" class="form-select" required>
                                    <option value="">-- Choose Category Sector --</option>
                                    <option value="@TenantCategory.Political">Political & National Voting Track</option>
                                    <option value="@TenantCategory.Educational">Academic Union / Educational Institution</option>
                                    <option value="@TenantCategory.Corporate">Corporate Board Room / Unions</option>
                                    <option value="@TenantCategory.Fashion">Fashion Pageant / Awards</option>
                                    <option value="@TenantCategory.Sports">Sports Leagues & Club Councils</option>
                                </select>
                                <span asp-validation-for="TenantCategory" class="text-danger xsmall"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ProfilePicture" class="form-label small fw-bold text-secondary">Workspace Brand Avatar / Profile Picture</label>
                                <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
                                <div class="form-text text-muted xsmall">Supported structures: JPEG, PNG, WEBP. Maximum file stream payload target: 4MB.</div>
                                <span asp-validation-for="ProfilePicture" class="text-danger xsmall"></span>
                            </div>
                        </div>

                        <h4 class="h5 fw-bold text-dark border-bottom pb-2 mb-4">
                            <i class="fas fa-user-shield text-primary me-2"></i>2. Master Administrator Identity Credentials
                        </h4>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="AdminEmail" class="form-label small fw-bold text-secondary">Administrative Security Email Contact</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="AdminEmail" type="email" class="form-control border-start-0" placeholder="admin@yourorganization.com" required />
                                </div>
                                <div class="form-text text-muted xsmall">Account validation and handshake activation confirmation tokens will deploy exclusively to this parameter address.</div>
                                <span asp-validation-for="AdminEmail" class="text-danger xsmall"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AdminPassword" class="form-label small fw-bold text-secondary">Account Execution Access Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-lock"></i></span>
                                    <input asp-for="AdminPassword" type="password" class="form-control border-start-0" placeholder="••••••••••••" required />
                                </div>
                                <span asp-validation-for="AdminPassword" class="text-danger xsmall"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Confirm Execution Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-lock"></i></span>
                                    <input type="password" name="ConfirmAdminPassword" class="form-control border-start-0" placeholder="••••••••••••" required />
                                </div>
                            </div>
                        </div>

                        <div class="form-check mb-4 bg-light p-3 rounded border-start border-primary border-3 ms-0">
                            <input class="form-check-input ms-1 me-2" type="checkbox" id="termsCheck" required />
                            <label class="form-check-label small fw-semibold text-dark" for="termsCheck">
                                I confirm the regulatory platform policy constraints and boundary configurations for this tenant initialization cycle.
                            </label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" asp-controller="Home" class="btn btn-light px-4 border shadow-sm rounded-pill fw-semibold">
                                <i class="fas fa-times me-1"></i> Cancel Setup
                            </a>
                            <button type="submit" class="btn btn-primary px-5 shadow rounded-pill fw-bold">
                                <i class="fas fa-rocket me-1"></i> Provision Workspace Environment
                            </button>
                        </div>
                    </form>

                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">Need an enterprise layout with specific ballot allocations? <a href="#" class="text-decoration-none fw-bold text-primary">Contact Platform Support</a></p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Dynamic client-side asynchronous field property validator modules configuration infrastructure hooks -->
    <partial name="_ValidationScriptsPartial" />
}
