@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h1 class="text-danger display-1 fw-bold">403</h1>
            <h2 class="fw-bold">Access Denied</h2>
            <p class="text-muted">You do not have permission to view this resource or perform this action.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Return to Home</a>
        </div>
    </div>
</div>
