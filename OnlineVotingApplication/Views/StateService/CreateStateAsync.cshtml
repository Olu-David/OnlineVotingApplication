@using OnlineVotingApplication.DataTransferView;
@model StateDTO;

@{
    TempData["Title"] = "Create_State_Async";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="fw-bold text-muted mb-4">Create State</h1>

            <form action="CreateStateAsync" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-0 rounded-3">
                @Html.AntiForgeryToken()

                <!-- GLOBAL VALIDATION SUMMARY BOX -->
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- STATE NAME INPUT -->
                <div class="mb-3">
                   @Model.Name to plain text to stop the application from crashing -->
                    <label asp-for="Name" class="form-label fw-medium">
                        <i class="fas fa-map-marker-alt"></i> State Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="Enter State's full name">
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- FORM ACTION BUTTONS -->
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                        <i class="fas fa-save"></i> Create State
                    </button>
                    <a asp-action="Index" asp-controller="State" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
