@model IEnumerable<OnlineVotingApplication.Models.ElectionEvent>

@{
    ViewData["Title"] = "Available Elections";
}

<div class="container py-5">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-poll text-primary me-2"></i>Available Election Events
            </h2>
            <p class="text-muted mb-0">Select an active election event below to view details, vote, or apply as a candidate.</p>
        </div>
    </div>

    <hr class="mb-4 text-muted opacity-25" />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var election in Model)
            {
                var isLive = DateTime.UtcNow >= election.StartDate && DateTime.UtcNow <= election.EndDate;

                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 election-card transition-all rounded-4 overflow-hidden">

                        <!-- Top Accent Banner / Status Badge -->
                        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                            @if (isLive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-3 py-2 rounded-pill">
                                    <span class="spinner-grow spinner-grow-sm me-1 text-success" role="status" style="width: 8px; height: 8px;"></span> Live Now
                                </span>
                            }
                            else if (DateTime.UtcNow < election.StartDate)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning fw-semibold px-3 py-2 rounded-pill">
                                    <i class="fas fa-clock me-1"></i> Upcoming
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold px-3 py-2 rounded-pill">
                                    <i class="fas fa-flag-checkered me-1"></i> Concluded
                                </span>
                            }
                            <small class="text-muted font-monospace"><i class="fas fa-calendar-alt me-1"></i>VoteX Poll</small>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h4 class="card-title fw-bold text-dark mb-2">@election.Title</h4>
                            <p class="card-text text-muted small flex-grow-1 mb-4" style="line-height: 1.6;">
                                @(string.IsNullOrEmpty(election.Description) ? "No description provided for this election event." : election.Description)
                            </p>

                            <!-- Timeline Box -->
                            <div class="bg-light p-3 rounded-3 mb-4 small text-secondary">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-hourglass-start text-primary me-2"></i>
                                    <span><strong>Starts:</strong> @election.StartDate.ToString("g")</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-hourglass-end text-danger me-2"></i>
                                    <span><strong>Ends:</strong> @election.EndDate.ToString("g")</span>
                                </div>
                            </div>

                            <!-- Single Action Button: View Ballot & Vote -->
                            <div class="mt-auto d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@election.Id" class="btn btn-primary fw-semibold py-2 rounded-3 shadow-sm">
                                    <i class="fas fa-vote-yea me-2"></i>View Ballot & Vote
                                </a>
                                <!-- Removed duplicate "Apply as Candidate" button – kept only in Details view -->
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm text-center py-5 rounded-4 bg-white">
                    <div class="card-body">
                        <div class="mb-3 text-muted display-4">
                            <i class="fas fa-folder-open opacity-50"></i>
                        </div>
                        <h5 class="fw-bold text-dark">No Active Elections Found</h5>
                        <p class="text-muted mb-0">There are currently no election events available for this tenant.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .election-card {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

            .election-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 1rem 3rem rgba(0,0,0,.08) !important;
            }
    </style>
}