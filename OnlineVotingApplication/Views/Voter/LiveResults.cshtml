@using OnlineVotingApplication.DataTransferView;
@model IEnumerable<CandidateVoteDto>
@{
    ViewData["Title"] = "Live Results Tally";
}

<div class="container-fluid px-4">
    <h2 class="mt-4">Live Results Tally</h2>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="SuperAdmin" asp-action="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Live Results</li>
    </ol>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>📊 Live Vote Tally Chart</h5>
        </div>
        <div class="card-body">
            <canvas id="liveResultsChart" width="400" height="150"></canvas>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Safely parse JSON from server-side variables rendered as clean strings
        const candidateNames = JSON.parse('@Html.Raw(Json.Serialize(Model.Select(c => c.CandidateName)))');
        const voteCounts = JSON.parse('@Html.Raw(Json.Serialize(Model.Select(c => c.VoteCount)))');

        const ctx = document.getElementById('liveResultsChart');
        if (ctx) {
            const liveResultsChart = new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: candidateNames,
                    datasets: [{
                        label: 'Votes Cast',
                        data: voteCounts,
                        backgroundColor: 'rgba(13, 110, 253, 0.7)',
                        borderColor: 'rgba(13, 110, 253, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        }
    </script>
}