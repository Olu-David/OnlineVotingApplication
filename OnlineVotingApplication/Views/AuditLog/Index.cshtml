@model IEnumerable<OnlineVotingApplication.Models.AuditLog>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">System Audit Trail</h2>
            <p class="text-muted small mb-0">Immutable flight-recorder ledger for tracking administrative and user actions.</p>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill shadow-sm">
                <i class="fas fa-shield-alt me-1"></i> Secure Ledger Active
            </span>
        </div>
    </div>

    <!-- Toast Notification for Copy Action -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div id="copyToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                    IP Address copied to clipboard!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">Timestamp (UTC)</th>
                            <th>User ID</th>
                            <th>Action Type</th>
                            <th>Details</th>
                            <th class="text-nowrap">IP Address</th>
                            <th>Tenant ID</th>
                            <th class="pe-4 text-end">Quick Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No audit logs recorded yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-nowrap"><small class="fw-semibold">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                                    <td><code>@(log.UserId ?? "System/Guest")</code></td>
                                    <td>
                                        @if (log.Action == "PENALTY_LOCKOUT")
                                        {
                                            <span class="badge bg-danger text-white fw-bold px-2 py-1">
                                                <i class="bi bi-shield-lock-fill me-1"></i> @log.Action
                                            </span>
                                        }
                                        else if (log.Action == "PENALTY_LIFTED")
                                        {
                                            <span class="badge bg-success text-white fw-bold px-2 py-1">
                                                <i class="bi bi-unlock-fill me-1"></i> @log.Action
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-dark fw-bold">@log.Action</span>
                                        }
                                    </td>
                                    <td>@log.Details</td>
                                    <!-- IP Address with Copy Feature -->
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex align-items-center bg-light border px-2 py-1 rounded">
                                            <code class="text-info me-2 user-select-all">@log.IpAddress</code>
                                            <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0" onclick="copyIpAddress('@log.IpAddress')" title="Copy IP Address">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td><small class="text-muted">@(log.TenantId.HasValue? log.TenantId.ToString() : "Global")</small></td>

                                    <!-- Quick Penalize Modal Trigger if UserId exists -->
                                    <td class="pe-4 text-end">
                                        @if (!string.IsNullOrEmpty(log.UserId))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#auditPenaltyModal-@log.Id" title="Penalty Lockout User">
                                                <i class="bi bi-shield-exclamation"></i> Penalize
                                            </button>

                                            <!-- Custom Penalty Message Modal for this log entry -->
                                            <div class="modal fade text-start" id="auditPenaltyModal-@log.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <!-- Directs straight to your PenaltyLockoutUser controller endpoint -->
                                                        <form asp-controller="SuperAdminDashboard" asp-action="PenaltyLockoutUser" method="post">
                                                            <input type="hidden" name="userId" value="@log.UserId" />
                                                            <div class="modal-header bg-danger text-white">
                                                                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Penalize User: @log.UserId</h5>
                                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="alert alert-warning small mb-3">
                                                                    This action will immediately execute a security restriction on the account, record an audit event, and email the explanation text below directly to the user.
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label for="violationReason-@log.Id" class="form-label fw-bold">Custom Violation Notice / Message</label>
                                                                    <textarea class="form-control" id="violationReason-@log.Id" name="violationReason" rows="4" required placeholder="Specify why this user is being penalized from the audit trail..."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger">Execute Penalty & Send Notice</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination Footer -->
    <div class="d-flex justify-content-between align-items-center mt-3 px-2">
        <div class="text-muted small">
            Showing page <strong>@ViewBag.CurrentPage</strong> (Page size: @ViewBag.PageSize)
        </div>
        <div>
            @if (ViewBag.CurrentPage > 1)
            {
                <a href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize, tenantIdStr = ViewBag.SelectedTenantId })" class="btn btn-sm btn-outline-secondary rounded-3 me-1">Previous</a>
            }
            <a href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize, tenantIdStr = ViewBag.SelectedTenantId })" class="btn btn-sm btn-outline-primary rounded-3">Next</a>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Microsoft SignalR Client Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        // Function to copy IP address to clipboard
        function copyIpAddress(ip) {
            navigator.clipboard.writeText(ip).then(() => {
                const toastEl = document.getElementById('copyToast');
                const toast = new bootstrap.Toast(toastEl);
                document.getElementById('toastMessage').innerText = `IP Address (${ip}) copied to clipboard!`;
                toast.show();
            }).catch(err => {
                console.error('Failed to copy IP: ', err);
            });
        }

        // Connect to the DashboardHub endpoint configured in Program.cs
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/dashboardHub")
            .withAutomaticReconnect()
            .build();

        // Listen for real-time audit log payloads broadcasted from AuditLogService
        connection.on("ReceiveAuditLog", function (log) {
            const tbody = document.querySelector("table tbody");

            // Clear out the "No audit logs recorded yet" placeholder if present
            const emptyRow = tbody.querySelector("td.text-center");
            if (emptyRow) {
                emptyRow.parentElement.remove();
            }

            // Badge coloring mapping
            let actionBadge = `<span class="badge bg-secondary-subtle text-dark fw-bold">${log.action}</span>`;
            if (log.action === "PENALTY_LOCKOUT") {
                actionBadge = `<span class="badge bg-danger text-white fw-bold px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i> ${log.action}</span>`;
            } else if (log.action === "PENALTY_LIFTED") {
                actionBadge = `<span class="badge bg-success text-white fw-bold px-2 py-1"><i class="bi bi-unlock-fill me-1"></i> ${log.action}</span>`;
            }

            // Generate contextual quick action button if a user ID exists
                  // Inside your SignalR connection.on("ReceiveAuditLog", function (log) { ... }) loop:

        // Use log.id (the database record primary key) instead of Math.random()
        const modalId = `auditPenaltyModal-${log.id}`;
        const quickActionCell = log.userId
            ? `<button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#${modalId}">Penalize</button>
               <div class="modal fade text-start" id="${modalId}" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog">
                     <div class="modal-content">
                        <form action="/SuperAdminDashboard/PenaltyLockoutUser" method="post">
                           <input type="hidden" name="userId" value="${log.userId}" />
                           <div class="modal-header bg-danger text-white">
                              <h5 class="modal-title">Penalize User: ${log.userId}</h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                           </div>
                           <div class="modal-body">
                              <div class="mb-3">
                                 <label class="form-label fw-bold">Custom Violation Notice</label>
                                 <textarea class="form-control" name="violationReason" rows="3" required placeholder="Reason for penalty..."></textarea>
                              </div>
                           </div>
                           <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-danger">Execute Penalty</button>
                           </div>
                        </form>
                     </div>
                  </div>
               </div>`
            : `<span class="text-muted small">N/A</span>`;
            // Create a brand new row with a brief highlight animation effect
            const newRow = document.createElement("tr");
            newRow.style.backgroundColor = "#e8f4fd";

            newRow.innerHTML = `
                <td class="ps-4 text-nowrap"><small class="fw-semibold">${log.timestamp}</small></td>
                <td><code>${log.userId ?? "System/Guest"}</code></td>
                <td>${actionBadge}</td>
                <td>${log.details}</td>
                <td class="text-nowrap">
                    <div class="d-inline-flex align-items-center bg-light border px-2 py-1 rounded">
                        <code class="text-info me-2 user-select-all">${log.ipAddress}</code>
                        <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0" onclick="copyIpAddress('${log.ipAddress}')" title="Copy IP">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </td>
                <td><small class="text-muted">${log.tenantId ?? "Global"}</small></td>
                <td class="pe-4 text-end">${quickActionCell}</td>
            `;

            // Prepend the new entry to the top of the table list
            tbody.insertBefore(newRow, tbody.firstChild);

            // Smoothly fade away the highlight background color after 1.5 seconds
            setTimeout(() => {
                newRow.style.transition = "background-color 1.5s ease";
                newRow.style.backgroundColor = "transparent";
            }, 500);
        });

        // Start the SignalR connection stream
        connection.start().then(() => {
            console.log("SignalR Real-Time Audit Stream Connected!");
        }).catch(err => console.error("SignalR Connection Error: ", err));
    </script>
}