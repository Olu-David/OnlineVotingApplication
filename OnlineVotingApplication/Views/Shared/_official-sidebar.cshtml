@{
    Layout = null;
    string userName = User?.Identity?.Name ?? "User";
    string initial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";
}

<nav class="admin-sidebar admin-sidebar--official bg-dark text-white d-flex flex-column" id="adminSidebar">
    <!-- Brand - Compact -->
    <div class="sidebar-brand d-flex align-items-center gap-2 px-2 py-2">
        <div class="brand-icon"><i class="fas fa-vote-yea"></i></div>
        <div class="brand-text">
            <span class="d-block fw-bold" style="font-size: 0.95rem;">VoteZy</span>
            <small class="text-white-50" style="font-size: 0.6rem;">Election Office</small>
        </div>
        <button class="btn btn-sm btn-outline-light border-0 ms-auto d-none d-lg-inline-flex" id="sidebarCollapseToggle" type="button">
            <i class="fas fa-angles-left"></i>
        </button>
    </div>

    <!-- User Chip - Tighter -->
    <div class="sidebar-user d-flex align-items-center gap-2 px-2 py-1 mb-1 bg-secondary bg-opacity-25 rounded mx-1">
        <span class="avatar-sm" style="width:28px; height:28px; font-size:0.7rem;">@initial</span>
        <div class="sidebar-user-info small overflow-hidden">
            <div class="fw-semibold text-truncate" style="font-size: 0.8rem;">@userName</div>
            <div class="sidebar-role-badge" style="font-size: 0.55rem; padding: 1px 6px;">Official</div>
        </div>
    </div>

    <!-- Navigation -->
    <ul class="nav flex-column flex-grow-1 overflow-y-auto px-1" style="gap: 1px;">

        <!-- ═══ OVERVIEW ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-1 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Overview</li>

        <li class="nav-item">
            <a asp-controller="Tenant" asp-action="Dashboard"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-tachometer-alt me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Dashboard</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Tenant" asp-action="ManageUsers"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "ManageUsers" ? "active" : "")">
                <i class="fas fa-users-gear me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Manage Admins</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Tenant" asp-action="ElectionAnalytics"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "ElectionAnalytics" ? "active" : "")">
                <i class="fas fa-chart-pie me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Election Analytics</span>
            </a>
        </li>

        <!-- ═══ ELECTION MANAGEMENT ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Election Management</li>

        <li class="nav-item">
            <a asp-controller="Voter" asp-action="LiveResults"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "Voter" && ViewData["Action"]?.ToString() == "LiveResults" ? "active" : "")">
                <span class="spinner-grow spinner-grow-sm me-2 text-danger" role="status" style="width: 6px; height: 6px;"></span><span style="font-size: 0.85rem;">Live Results</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Voter" asp-action="ManualEntry"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "Voter" && ViewData["Action"]?.ToString() == "ManualEntry" ? "active" : "")">
                <i class="fas fa-file-pen me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Manual Entry</span>
            </a>
        </li>

        <!-- ═══ CANDIDATES ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Candidates</li>

        <li class="nav-item">
            <a href="#candidatesDropdown"
               class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "Candidate" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(ViewData["Ctrl"]?.ToString() == "Candidate" ? "true" : "false")">
                <span><i class="fas fa-user-tie me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Candidates</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(ViewData["Ctrl"]?.ToString() == "Candidate" || ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "CreateCandidateOfficial" ? "show" : "")" id="candidatesDropdown">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="AllCandidate"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "AllCandidate" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All Candidates</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="GetUnsentCandidateApplicationsAsync"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "GetUnsentCandidateApplicationsAsync" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-user-clock me-2 text-warning" style="width: 14px;"></i><span>Pending Apps</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="GetSentCandidateInvitationsAsync"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "GetSentCandidateInvitationsAsync" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-paper-plane me-2 text-info" style="width: 14px;"></i><span>Sent Invites</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1 opacity-25" /></li>
                    <li class="nav-item">
                        <a asp-controller="Tenant" asp-action="CreateCandidateOfficial"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "CreateCandidateOfficial" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-user-plus me-2 text-success" style="width: 14px;"></i><span>Create Candidate</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- ═══ ELECTIONS ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Elections</li>

        <li class="nav-item">
            <a href="#electionsDropdown"
               class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(ViewData["Ctrl"]?.ToString() == "ElectionEvent" ? "true" : "false")">
                <span><i class="fas fa-calendar-alt me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Elections</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" ? "show" : "")" id="electionsDropdown">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="Index"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" && ViewData["Action"]?.ToString() == "Index" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All Elections</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="Create"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" && ViewData["Action"]?.ToString() == "Create" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-plus-circle me-2" style="width: 14px;"></i><span>Create Election</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="SoftDeleted"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" && ViewData["Action"]?.ToString() == "SoftDeleted" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-trash-restore me-2 text-danger" style="width: 14px;"></i><span>Deleted</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- ═══ POSITIONS ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Positions</li>

        <li class="nav-item">
            <a href="#positionsDropdown"
               class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "Position" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(ViewData["Ctrl"]?.ToString() == "Position" ? "true" : "false")">
                <span><i class="fas fa-bullseye me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Positions</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(ViewData["Ctrl"]?.ToString() == "Position" ? "show" : "")" id="positionsDropdown">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="Position" asp-action="Index"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "Position" && ViewData["Action"]?.ToString() == "Index" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All Positions</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Position" asp-action="CreatePosition"
                           class="nav-link text-white-50 @(ViewData["Ctrl"]?.ToString() == "Position" && ViewData["Action"]?.ToString() == "CreatePosition" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-plus-circle me-2" style="width: 14px;"></i><span>Create Position</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- ═══ SECURITY & OVERSIGHT ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Security & Oversight</li>

        <li class="nav-item">
            <a asp-controller="Voter" asp-action="PenalizedVoters"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "Voter" && ViewData["Action"]?.ToString() == "PenalizedVoters" ? "active" : "")">
                <i class="fas fa-user-slash me-2 text-danger" style="width: 16px;"></i><span style="font-size: 0.85rem;">Penalized Voters</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="AuditLog" asp-action="Index"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "AuditLog" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-clipboard-list me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Audit Logs</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Home" asp-action="SupportTickets"
               class="nav-link text-white d-flex align-items-center @(ViewData["Ctrl"]?.ToString() == "Home" && ViewData["Action"]?.ToString() == "SupportTickets" ? "active" : "")">
                <i class="fas fa-headset me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Support Tickets</span>
            </a>
        </li>

    </ul>

    <!-- Footer - Compact Logout -->
    <div class="sidebar-footer mt-auto pt-1 border-top border-secondary opacity-75">
        <form class="form-inline w-100" asp-controller="AuthService" asp-action="LogoutUser" method="post">
            <button type="submit" class="nav-link text-danger d-flex align-items-center w-100 bg-transparent border-0 px-2 py-1 rounded text-start" style="font-size: 0.85rem;">
                <i class="fas fa-sign-out-alt me-2" style="width: 16px;"></i>
                <span>Sign Out</span>
            </button>
        </form>
    </div>
</nav>