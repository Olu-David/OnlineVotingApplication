@model List<OnlineVotingApplication.Models.ElectionEvent>

@{
    ViewData["Title"] = "My Voting History";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-3">📜 My Voting History</h2>
            <p class="text-muted">Below are the election events you have successfully participated in.</p>
            <hr />

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    You have not participated in any election events yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Election Title</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var election in Model)
                            {
                                <tr>
                                    <td><strong>@election.Title</strong></td>
                                    <td>@election.StartDate.ToString("g")</td>
                                    <td>@election.EndDate.ToString("g")</td>
                                    <td class="text-end">
                                        <a asp-action="BallotBreakdown" asp-route-electionId="@election.Id" class="btn btn-sm btn-outline-primary">
                                            View My Ballot Receipt
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>