@using Microsoft.AspNetCore.Identity
@using OnlineVotingApplication.Areas.Identity.Data
@using OnlineVotingApplication.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    // ─── ROLE & AUTH STATE ──────────────────────────────────────────
    bool isAuth = User?.Identity?.IsAuthenticated ?? false;
    bool isSuperAdmin = isAuth && User!.IsInRole("SuperAdmin");
    bool isOfficial = isAuth && User!.IsInRole("Official");
    bool isAuditor = isAuth && User!.IsInRole("Auditor");
    bool isCandidate = isAuth && User!.IsInRole("Candidate");
    bool isVoter = isAuth && User!.IsInRole("Voter");
    bool isBlocked = isAuth && !(isSuperAdmin || isOfficial || isAuditor || isCandidate || isVoter);

    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string dashCtrl = isVoter ? "Voter"
                    : isOfficial ? "Official"
                    : isAuditor ? "Auditor"
                    : isSuperAdmin ? "SuperAdmin"
                    : isCandidate ? "Candidate"
                    : "Home";

    string nameInitial = (isAuth && !string.IsNullOrEmpty(User?.Identity?.Name))
                       ? User!.Identity!.Name![0].ToString().ToUpper()
                       : "?";

    string roleBadge = isSuperAdmin ? "SuperAdmin"
                     : isOfficial ? "Official"
                     : isAuditor ? "Auditor"
                     : isCandidate ? "Candidate"
                     : isVoter ? "Voter"
                     : "";

    string roleColor = isSuperAdmin ? "danger"
                     : isOfficial ? "primary"
                     : isAuditor ? "warning"
                     : isCandidate ? "info"
                     : isVoter ? "success"
                     : "secondary";

    ViewData["IsAuth"] = isAuth;
    ViewData["IsSuperAdmin"] = isSuperAdmin;
    ViewData["IsOfficial"] = isOfficial;
    ViewData["IsAuditor"] = isAuditor;
    ViewData["IsCandidate"] = isCandidate;
    ViewData["IsVoter"] = isVoter;
    ViewData["IsBlocked"] = isBlocked;
    ViewData["DashCtrl"] = dashCtrl;
    ViewData["Ctrl"] = ctrl;
    ViewData["Action"] = action;
    ViewData["NameInitial"] = nameInitial;
    ViewData["RoleBadge"] = roleBadge;
    ViewData["RoleColor"] = roleColor;
    ViewData["User"] = User;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — VoteX</title>

    <link rel="icon" type="image/svg+xml" href="/vote-yea-119581-3b82f6.svg" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Custom styles (only what Bootstrap doesn't cover) -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/navbar.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(isSuperAdmin ? "vx-admin-body" : "vx-public-body")">

    @if (isSuperAdmin)
    {
        <div class="admin-shell d-flex">

            <!-- SIDEBAR -->
            <partial name="_SuperAdminSidebar" />

            <!-- MAIN COLUMN -->
            <div class="d-flex flex-column flex-grow-1">

                @* <!-- TOPBAR -->
                <partial name="_AdminTopbar" /> *@

                <!-- CONTENT -->
                <main class="admin-content p-4">
                    <partial name="_Alerts" />
                    @if (!isBlocked)
                    {
                        @RenderBody()
                    }
                </main>

            </div>
        </div>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    }
    else
    {
        <partial name="_Navbar" />
        <main class="flex-grow-1">
            <div class="container py-4">
                <partial name="_Alerts" />
                @if (!isBlocked)
                {
                    @RenderBody()
                }
            </div>
        </main>
        <partial name="_Footer" />
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <script src="/js/navbar.js" asp-append-version="true"></script>
    <script src="/js/sidebar.js" asp-append-version="true"></script>
    <script src="/js/alerts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>