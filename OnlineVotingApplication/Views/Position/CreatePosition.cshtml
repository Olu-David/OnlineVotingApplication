@model OnlineVotingApplication.DataTransferView.PositionDTO

@{
    ViewData["Title"] = "Create Position";
    Layout = "_Layout";
    bool isSuperAdmin = ViewBag.IsSuperAdmin ?? false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Create New Position</h4>
                </div>
                <div class="card-body p-4">
                    <!-- Updated asp-action to point directly to CreatePosition -->
                    <form asp-action="CreatePosition" method="post" id="createPositionForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ElectionId" class="form-label fw-bold">Target Election Event</label>
                            <select asp-for="ElectionId" asp-items="ViewBag.ElectionEvents" class="form-select">
                                <option value="">-- Select Election Event --</option>
                            </select>
                            <span asp-validation-for="ElectionId" class="text-danger"></span>
                            @if (isSuperAdmin)
                            {
                                <small class="form-text text-muted">SuperAdmin view: Showing all active system election events.</small>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Position Title</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. President, General Secretary, Treasurer" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Index" asp-route-electionId="@Model?.ElectionId" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" id="submitBtn" class="btn btn-success px-4">
                                <i class="fas fa-save me-1"></i> Save Position
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Disable submit button on click to prevent multi-submit bugs when form is valid
        document.getElementById('createPositionForm').addEventListener('submit', function (e) {
            if ($(this).valid()) {
                const btn = document.getElementById('submitBtn');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
            }
        });
    </script>
}