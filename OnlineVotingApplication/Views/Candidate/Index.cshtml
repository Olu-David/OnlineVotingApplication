@using OnlineVotingApplication.DataTransferView
@model List<CandidateViewModel>

@* ===== WHAT IS THIS? =====
   This view shows a list of ALL candidates
   It's what users see when they visit /Candidate or /Candidate/Index
*@

@{
    ViewBag.Title = "All Candidates";
    Layout = "_Layout"; // 
}

<div class="container mt-5">
    <!-- PAGE HEADER -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-2">
                <i class="fas fa-users"></i> Candidates
            </h1>
            <p class="text-muted">Browse all available candidates</p>
        </div>

        <!-- CREATE BUTTON (only for admins) -->
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Official"))
        {
            <div class="col-md-4 text-end">
                <a href="/Candidate/Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus"></i> Add New Candidate
                </a>
            </div>
        }
    </div>

    <!-- SUCCESS/ERROR MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- CANDIDATES GRID -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var candidate in Model)
            {
                <!-- SINGLE CANDIDATE CARD -->
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <!-- CANDIDATE IMAGE -->
                        <div style="height: 250px; overflow: hidden; background: #f0f0f0;">
                            <img src="@candidate.image"
                                 alt="@candidate.Name"
                                 style="width: 100%; height: 100%; object-fit: cover;"
                                 class="card-img-top" />
                        </div>

                        <!-- CARD BODY -->
                        <div class="card-body">
                            <!-- NAME -->
                            <h5 class="card-title">
                                @candidate.Name
                            </h5>

                            <!-- PARTY -->
                            <p class="text-muted small mb-2">
                                <i class="fas fa-flag"></i> Party: @candidate.PartyName
                            </p>

                            <!-- POSITION -->
                            <p class="text-muted small mb-2">
                                <i class="fas fa-briefcase"></i> Position: @candidate.Position
                            </p>

                            <!-- STATE -->
                            <p class="text-muted small mb-3">
                                <i class="fas fa-map-marker-alt"></i> State: @candidate.StateName
                            </p>

                            <!-- MANIFESTO (short preview) -->
                            <p class="card-text small">
                                @(candidate.Manifesto?.Length > 100
                                                        ? candidate.Manifesto.Substring(0, 100) + "..."
                                                        : candidate.Manifesto)
                    </p>
                </div>

                        <!-- CARD FOOTER WITH BUTTONS -->
                        <div class="card-footer bg-light">
                            <div class="d-flex gap-2">
                                <!-- VIEW DETAILS BUTTON -->
                                <a href="/Candidate/Details/@candidate.CandidateID"
                                   class="btn btn-sm btn-primary flex-grow-1">
                                    <i class="fas fa-eye"></i> View Details
                                </a>

                                <!-- EDIT BUTTON (only for admins) -->
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Official"))
                                {
                                    <a href="/Candidate/Edit/@candidate.CandidateID"
                                       class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- NO CANDIDATES MESSAGE -->
        <div class="alert alert-info text-center p-5">
            <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
            <h5>No candidates found</h5>
            <p>There are currently no candidates available.</p>
        </div>
    }
</div>
