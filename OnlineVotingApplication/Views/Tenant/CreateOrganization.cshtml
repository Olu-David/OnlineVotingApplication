@using OnlineVotingApplication.Enums
@model OnlineVotingApplication.DataTransferView.TenantRegistrationViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Register Your Organization";
}

@section Styles {
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            <div class="text-center mb-4">
                <div class="auth-icon" style="width: 64px; height: 64px; margin-bottom: 1rem;">
                    <i class="fas fa-building fa-lg"></i>
                </div>
                <h1 class="auth-title" style="font-size: 1.75rem; color: var(--votex-navy-900);">Register Your Organization</h1>
                <p class="text-muted">Set up a secure election workspace for your organization, and create the admin account that will manage it.</p>
            </div>

            <div class="card auth-card">
                <div class="auth-card-body p-4 p-md-5">

                    <form asp-controller="Tenant" asp-action="CreateOrganization" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small mb-4" role="alert"></div>

                        <h4 class="org-section-title">
                            <span class="step-no">1</span> Organization details
                        </h4>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="OrganizationName" class="form-label">Organization Name</label>
                                <input asp-for="OrganizationName" type="text" class="form-control" placeholder="e.g. Abuja University, Lagos State Tech" required />
                                <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TenantCategory" class="form-label">Category</label>
                                <select asp-for="TenantCategory" class="form-select" required>
                                    <option value="">-- Choose a category --</option>
                                    <option value="@TenantCategory.Political">Political / National Election</option>
                                    <option value="@TenantCategory.Educational">Academic Union / Educational Institution</option>
                                    <option value="@TenantCategory.Corporate">Corporate Board / Union</option>
                                    <option value="@TenantCategory.Fashion">Fashion Pageant / Awards</option>
                                    <option value="@TenantCategory.Sports">Sports League / Club Council</option>
                                </select>
                                <span asp-validation-for="TenantCategory" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ProfilePicture" class="form-label">Organization Logo</label>
                                <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
                                <div class="form-text text-muted">JPEG, PNG or WEBP. Max size 4MB.</div>
                                <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                            </div>
                        </div>

                        <h4 class="org-section-title">
                            <span class="step-no">2</span> Admin account
                        </h4>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="AdminEmail" class="form-label">Admin Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="AdminEmail" type="email" class="form-control border-start-0" placeholder="admin@yourorganization.com" required />
                                </div>
                                <div class="form-text text-muted">We'll send your verification link to this address.</div>
                                <span asp-validation-for="AdminEmail" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AdminPassword" class="form-label">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-lock"></i></span>
                                    <input asp-for="AdminPassword" type="password" class="form-control border-start-0" placeholder="••••••••••••" required />
                                </div>
                                <span asp-validation-for="AdminPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Confirm Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-lock"></i></span>
                                    <input type="password" name="ConfirmAdminPassword" class="form-control border-start-0" placeholder="••••••••••••" required />
                                </div>
                            </div>
                        </div>

                        <div class="form-check mb-4 org-terms-box p-3 ms-0">
                            <input class="form-check-input ms-1 me-2" type="checkbox" id="termsCheck" required />
                            <label class="form-check-label small fw-semibold text-dark" for="termsCheck">
                                I agree to the Terms of Service and Election Policy for this organization.
                            </label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" asp-controller="Home" class="btn btn-light px-4 border shadow-sm rounded-pill fw-semibold">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn auth-btn-primary px-5 shadow rounded-pill">
                                <i class="fas fa-rocket me-1"></i> Create Organization
                            </button>
                        </div>
                    </form>

                </div>
            </div>

            <div class="text-center mt-4">
                <p class="auth-footnote">Need a custom setup for larger ballot allocations? <a href="#">Contact platform support</a></p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
