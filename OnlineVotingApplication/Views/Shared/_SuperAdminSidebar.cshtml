@{
    Layout = null;
    var currentCtrl = ViewData["Ctrl"]?.ToString();
    var currentAction = ViewData["Action"]?.ToString();
    bool isPlatformAdmin = ViewData["IsPlatformAdmin"] is bool pAdmin && pAdmin;
}
@using Microsoft.AspNetCore.Identity
@using OnlineVotingApplication.Areas.Identity.Data
@inject SignInManager<ApplicationUser> SignInManager

<nav class="admin-sidebar admin-sidebar--superadmin bg-dark text-white d-flex flex-column" id="adminSidebar">
    <!-- Brand - Compact -->
    <div class="sidebar-brand d-flex align-items-center gap-2 px-2 py-2">
        <div class="brand-icon"><i class="fas fa-shield-alt text-warning"></i></div>
        <div class="brand-text">
            <span class="d-block fw-bold" style="font-size: 0.95rem;">VoteX</span>
            <small class="text-warning font-monospace" style="font-size: 0.6rem;">@(isPlatformAdmin ? "Platform Admin" : "Super Admin")</small>
        </div>
        <button class="btn btn-sm btn-outline-light border-0 ms-auto d-none d-lg-inline-flex" id="sidebarCollapseToggle" type="button">
            <i class="fas fa-angles-left"></i>
        </button>
    </div>

    <!-- User Chip - Tighter -->
    <div class="sidebar-user d-flex align-items-center gap-2 px-2 py-1 mb-1 bg-secondary bg-opacity-25 rounded mx-1">
        <span class="avatar-sm bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width:28px; height:28px; font-size:0.7rem;">
            @(ViewData["NameInitial"] ?? "SA")
        </span>
        <div class="sidebar-user-info small overflow-hidden">
            <div class="fw-semibold text-truncate" style="font-size: 0.8rem;">@User?.Identity?.Name</div>
            <span class="badge @(isPlatformAdmin ? "bg-dark border border-danger text-danger" : "bg-danger") text-uppercase" style="font-size: 0.55rem; padding: 1px 6px;">
                @(isPlatformAdmin ? "Platform" : "Root")
            </span>
        </div>
    </div>

    <!-- Navigation -->
    <ul class="nav flex-column flex-grow-1 overflow-y-auto px-1" style="gap: 1px;">

        <!-- ═══ OVERVIEW ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-1 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Overview</li>

        <li class="nav-item">
            <a asp-controller="SuperAdminDashboard" asp-action="Dashboard"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "SuperAdminDashboard" && currentAction == "Dashboard" ? "active" : "")">
                <i class="fas fa-tachometer-alt me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Global Dashboard</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Voter" asp-action="LiveResults"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "Voter" && currentAction == "LiveResults" ? "active" : "")">
                <span class="spinner-grow spinner-grow-sm me-2 text-info" role="status" style="width: 6px; height: 6px;"></span><span style="font-size: 0.85rem;">Live Analytics</span>
            </a>
        </li>

        <!-- ═══ PLATFORM GOVERNANCE ═══ -->
        @if (isPlatformAdmin)
        {
            <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0 text-danger" style="font-size: 0.6rem; letter-spacing: 0.06em;">
                <i class="fas fa-server me-1" style="font-size: 0.5rem;"></i> Platform Governance
            </li>
            <li class="nav-item">
                <a asp-controller="SuperAdminDashboard" asp-action="AllTenants"
                   class="nav-link text-white d-flex align-items-center @(currentCtrl == "SuperAdminDashboard" && currentAction == "AllTenants" ? "active" : "")">
                    <i class="fas fa-network-wired me-2 text-warning" style="width: 16px;"></i><span style="font-size: 0.85rem;">Cross-Tenant Infrastructure</span>
                </a>
            </li>
        }

        <!-- ═══ MULTI-TENANCY ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Multi-Tenancy</li>

        <li class="nav-item">
            <a href="#TenantMenu"
               class="nav-link text-white d-flex align-items-center justify-content-between @(currentCtrl == "SuperAdminDashboard" && (currentAction == "AllTenants" || currentAction == "GetAllPendingTenants") ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(currentCtrl == "SuperAdminDashboard" && (currentAction == "AllTenants" || currentAction == "GetAllPendingTenants") ? "true" : "false")">
                <span><i class="fas fa-building me-2 text-warning" style="width: 16px;"></i><span style="font-size: 0.85rem;">Organizations</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(currentCtrl == "SuperAdminDashboard" && (currentAction == "AllTenants" || currentAction == "GetAllPendingTenants") ? "show" : "")" id="TenantMenu">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="SuperAdminDashboard" asp-action="AllTenants"
                           class="nav-link text-white-50 @(currentCtrl == "SuperAdminDashboard" && currentAction == "AllTenants" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All Organizations</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="SuperAdminDashboard" asp-action="GetAllPendingTenants"
                           class="nav-link text-white-50 @(currentCtrl == "SuperAdminDashboard" && currentAction == "GetAllPendingTenants" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-clock me-2 text-warning" style="width: 14px;"></i><span>Pending Approval</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- ═══ ELECTION OPERATIONS ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Election Operations</li>

        <!-- Elections -->
        <li class="nav-item">
            <a href="#electionMenu"
               class="nav-link text-white d-flex align-items-center justify-content-between @(currentCtrl == "ElectionEvent" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(currentCtrl == "ElectionEvent" ? "true" : "false")">
                <span><i class="fas fa-poll me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Elections</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(currentCtrl == "ElectionEvent" ? "show" : "")" id="electionMenu">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="Index"
                           class="nav-link text-white-50 @(currentCtrl == "ElectionEvent" && currentAction == "Index" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All Elections</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="Create"
                           class="nav-link text-white-50 @(currentCtrl == "ElectionEvent" && currentAction == "Create" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-plus-circle me-2" style="width: 14px;"></i><span>Create Election</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="SoftDeleted"
                           class="nav-link text-white-50 @(currentCtrl == "ElectionEvent" && currentAction == "SoftDeleted" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-trash-restore me-2 text-danger" style="width: 14px;"></i><span>Deleted</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- Candidates -->
        <li class="nav-item">
            <a href="#CandidateMenu"
               class="nav-link text-white d-flex align-items-center justify-content-between @(currentCtrl == "Candidate" || currentCtrl == "SuperAdminDashboard" && currentAction == "CreateCandidateSuperAdmin" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(currentCtrl == "Candidate" || currentCtrl == "SuperAdminDashboard" && currentAction == "CreateCandidateSuperAdmin" ? "true" : "false")">
                <span><i class="fas fa-user-tie me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Candidates</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(currentCtrl == "Candidate" || currentCtrl == "SuperAdminDashboard" && currentAction == "CreateCandidateSuperAdmin" ? "show" : "")" id="CandidateMenu">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="AllCandidate"
                           class="nav-link text-white-50 @(currentCtrl == "Candidate" && currentAction == "AllCandidate" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-users me-2" style="width: 14px;"></i><span>All Candidates</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="PendingCandidateApplications"
                           class="nav-link text-white-50 @(currentCtrl == "Candidate" && currentAction == "PendingCandidateApplications" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-clipboard-list me-2 text-warning" style="width: 14px;"></i><span>Pending Apps</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="SuperAdminDashboard" asp-action="CreateCandidateSuperAdmin"
                           class="nav-link text-white-50 @(currentCtrl == "SuperAdminDashboard" && currentAction == "CreateCandidateSuperAdmin" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-user-plus me-2 text-success" style="width: 14px;"></i><span>Create Candidate</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1 opacity-25" /></li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="GetAllSoftdelete"
                           class="nav-link text-white-50 @(currentCtrl == "Candidate" && currentAction == "GetAllSoftdelete" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-trash-restore me-2 text-danger" style="width: 14px;"></i><span>Deleted</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- Positions -->
        <li class="nav-item">
            <a href="#PositionMenu"
               class="nav-link text-white d-flex align-items-center justify-content-between @(currentCtrl == "Position" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(currentCtrl == "Position" ? "true" : "false")">
                <span><i class="fas fa-bullseye me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Positions</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(currentCtrl == "Position" ? "show" : "")" id="PositionMenu">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="Position" asp-action="Index"
                           class="nav-link text-white-50 @(currentCtrl == "Position" && currentAction == "Index" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All Positions</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Position" asp-action="CreatePosition"
                           class="nav-link text-white-50 @(currentCtrl == "Position" && currentAction == "CreatePosition" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-plus-circle me-2" style="width: 14px;"></i><span>Create Position</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1 opacity-25" /></li>
                    <li class="nav-item">
                        <a asp-controller="Position" asp-action="AllSoftDelete"
                           class="nav-link text-white-50 @(currentCtrl == "Position" && currentAction == "AllSoftDelete" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-trash-restore me-2 text-danger" style="width: 14px;"></i><span>Deleted</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- Form Builder -->
        <li class="nav-item mt-1">
            <a asp-controller="SuperAdminDashboard" asp-action="BuildGlobalForm"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "SuperAdminDashboard" && currentAction == "BuildGlobalForm" ? "active" : "")">
                <i class="fas fa-wpforms me-2 text-info" style="width: 16px;"></i><span style="font-size: 0.85rem;">Build Global Form</span>
            </a>
        </li>

        <!-- ═══ GEOGRAPHY ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Geographic Data</li>

        <!-- States -->
        <li class="nav-item">
            <a href="#Statedropdown"
               class="nav-link text-white d-flex align-items-center justify-content-between @(currentCtrl == "StateService" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(currentCtrl == "StateService" ? "true" : "false")">
                <span><i class="fas fa-map me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">States</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(currentCtrl == "StateService" ? "show" : "")" id="Statedropdown">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="StateService" asp-action="AllState"
                           class="nav-link text-white-50 @(currentCtrl == "StateService" && currentAction == "AllState" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All States</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="StateService" asp-action="CreateState"
                           class="nav-link text-white-50 @(currentCtrl == "StateService" && currentAction == "CreateState" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-plus-circle me-2" style="width: 14px;"></i><span>Create State</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- LGAs -->
        <li class="nav-item">
            <a href="#Lgadropdown"
               class="nav-link text-white d-flex align-items-center justify-content-between @(currentCtrl == "Lga" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(currentCtrl == "Lga" ? "true" : "false")">
                <span><i class="fas fa-university me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">LGAs</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(currentCtrl == "Lga" ? "show" : "")" id="Lgadropdown">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="Lga" asp-action="AllLga"
                           class="nav-link text-white-50 @(currentCtrl == "Lga" && currentAction == "AllLga" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All LGAs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Lga" asp-action="CreateLga"
                           class="nav-link text-white-50 @(currentCtrl == "Lga" && currentAction == "CreateLga" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-plus-circle me-2" style="width: 14px;"></i><span>Create LGA</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- Parties -->
        <li class="nav-item">
            <a href="#PartyDropdown"
               class="nav-link text-white d-flex align-items-center justify-content-between @(currentCtrl == "Party" ? "" : "collapsed")"
               data-bs-toggle="collapse" aria-expanded="@(currentCtrl == "Party" ? "true" : "false")">
                <span><i class="fas fa-flag me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Political Parties</span></span>
                <i class="fas fa-chevron-down small ms-auto" style="font-size: 0.6rem;"></i>
            </a>
            <div class="collapse @(currentCtrl == "Party" ? "show" : "")" id="PartyDropdown">
                <ul class="nav flex-column ms-3 mt-0" style="gap: 1px;">
                    <li class="nav-item">
                        <a asp-controller="Party" asp-action="AllParty"
                           class="nav-link text-white-50 @(currentCtrl == "Party" && currentAction == "AllParty" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-list me-2" style="width: 14px;"></i><span>All Parties</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Party" asp-action="CreateParty"
                           class="nav-link text-white-50 @(currentCtrl == "Party" && currentAction == "CreateParty" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-plus-circle me-2" style="width: 14px;"></i><span>Create Party</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1 opacity-25" /></li>
                    <li class="nav-item">
                        <a asp-controller="Party" asp-action="AllSoftDeleted"
                           class="nav-link text-white-50 @(currentCtrl == "Party" && currentAction == "AllSoftDeleted" ? "active text-white fw-bold" : "")" style="font-size: 0.8rem;">
                            <i class="fas fa-trash-restore me-2 text-danger" style="width: 14px;"></i><span>Deleted</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- ═══ ADMINISTRATION & AUDIT ═══ -->
        <li class="sidebar-section-label text-muted small text-uppercase fw-bold px-2 mt-2 mb-0" style="font-size: 0.6rem; letter-spacing: 0.06em;">Administration & Audit</li>

        <li class="nav-item">
            <a asp-controller="Voter" asp-action="ManualEntry"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "Voter" && currentAction == "ManualEntry" ? "active" : "")">
                <i class="fas fa-file-invoice me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">Manual Entry</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="SuperAdminDashboard" asp-action="AllSystemUsers"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "SuperAdminDashboard" && currentAction == "AllSystemUsers" ? "active" : "")">
                <i class="fas fa-users me-2" style="width: 16px;"></i><span style="font-size: 0.85rem;">All System Users</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="SuperAdminDashboard" asp-action="PenalizedUsers"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "SuperAdminDashboard" && currentAction == "PenalizedUsers" ? "active" : "")">
                <i class="fas fa-user-lock me-2 text-danger" style="width: 16px;"></i><span style="font-size: 0.85rem;">Penalized Users</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Voter" asp-action="PenalizedVoters"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "Voter" && currentAction == "PenalizedVoters" ? "active" : "")">
                <i class="fas fa-user-slash me-2 text-danger" style="width: 16px;"></i><span style="font-size: 0.85rem;">Penalized Voters</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="AuditLog" asp-action="Index"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "AuditLog" && currentAction == "Index" ? "active" : "")">
                <i class="fas fa-clipboard-list me-2 text-warning" style="width: 16px;"></i><span style="font-size: 0.85rem;">System Audit Logs</span>
            </a>
        </li>

        <li class="nav-item mt-1">
            <a asp-controller="Home" asp-action="SupportTickets"
               class="nav-link text-white d-flex align-items-center @(currentCtrl == "Home" && currentAction == "SupportTickets" ? "active" : "")">
                <i class="fas fa-headset me-2 text-info" style="width: 16px;"></i><span style="font-size: 0.85rem;">Support Tickets</span>
            </a>
        </li>

    </ul>

    <!-- Footer - Compact Logout -->
    <div class="sidebar-footer mt-auto pt-1 border-top border-secondary opacity-75">
        @if (User != null && SignInManager.IsSignedIn(User))
        {
            <form class="form-inline w-100" asp-controller="AuthService" asp-action="LogoutUser" method="post">
                <button type="submit" class="nav-link text-danger d-flex align-items-center w-100 bg-transparent border-0 px-2 py-1 rounded text-start" style="font-size: 0.85rem;">
                    <i class="fas fa-sign-out-alt me-2" style="width: 16px;"></i>
                    <span>Sign Out</span>
                </button>
            </form>
        }
    </div>
</nav>

<style>
    /* ─── Mobile scroll fix ─── */
    @@media (max-width: 991.98px) {
        .admin-sidebar {
            overflow-y: auto !important;
            -webkit-overflow-scrolling: touch;
            height: 100vh;
            height: 100dvh;
        }

            .admin-sidebar ul.nav {
                overflow-y: visible !important;
            }
    }
</style>