@model IEnumerable<OnlineVotingApplication.DataTransferView.TenantViewModel>

@{
    ViewData["Title"] = "Select Voting Workspace";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-5">
                <i class="fas fa-cubes fa-3x text-primary mb-3"></i>
                <h1 class="h3 fw-bold text-dark">Select Your Voting Workspace</h1>
                <p class="text-muted">Choose an active organization profile to load your customized election dashboard.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <div class="list-group shadow-sm border-0 rounded-3 overflow-hidden">
                @if (Model != null && Model.Any())
                {
                    foreach (var tenant in Model)
                    {
                        <div class="list-group-item list-group-item-action p-4 border-bottom d-flex w-100 justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="bg-light border text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <i class="fas fa-building"></i>
                                </div>
                                <div>
                                    <h5 class="mb-1 fw-bold text-dark">@tenant.OrganizationName</h5>
                                    <small class="text-muted font-monospace bg-light px-2 py-0.5 rounded">/@tenant.Slug</small>
                                </div>
                            </div>

                            <form asp-action="SwitchContext" asp-controller="Tenant" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@tenant.Id" />
                                <button type="submit" class="btn btn-primary btn-sm px-3 rounded-pill">
                                    Launch <i class="fas fa-arrow-right ms-1 text-xs"></i>
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <div class="list-group-item text-center py-5 bg-light border-0">
                        <i class="fas fa-id-card-alt fa-3x text-muted mb-3 opacity-50"></i>
                        <h5 class="text-secondary fw-semibold">No Available Workspaces</h5>
                        <p class="text-muted small mb-0 px-4">Your profile isn't linked to any active target organizations. Reach out to your platform administrator to link your profile.</p>
                    </div>
                }
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" asp-controller="Home" class="text-decoration-none small text-muted">
                    <i class="fas fa-long-arrow-alt-left me-1"></i> Back to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
