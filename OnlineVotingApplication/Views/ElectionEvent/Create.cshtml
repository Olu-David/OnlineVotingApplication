@model OnlineVotingApplication.DataTransferView.ElectionViewModel
@{
    ViewData["Title"] = "Create Election";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<div class="container-fluid px-4">
    <div class="my-4">
        <h1 class="h3 mb-0 text-gray-800">Create Election Event</h1>
        <p class="text-muted small">Configure timing and basic parameters for a new voting cycle.</p>
    </div>

    <div class="row">
        <div class="col-xl-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. 2026 Student Union Election" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ElectionYear" class="form-label fw-bold"></label>
                                <input asp-for="ElectionYear" class="form-control" />
                                <span asp-validation-for="ElectionYear" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <select asp-for="Category" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>

                        @if (isSuperAdmin && ViewBag.Tenants != null)
                        {
                            <div class="mb-3">
                                <label asp-for="TenantId" class="form-label fw-bold">Target Organization (Tenant)</label>
                                <select asp-for="TenantId" class="form-select" asp-items="ViewBag.Tenants">
                                    <option value="">-- System-wide (Global) --</option>
                                </select>
                                <span asp-validation-for="TenantId" class="text-danger small"></span>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label fw-bold"></label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label fw-bold"></label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                            <label class="form-check-label fw-bold" for="isActiveSwitch">Make Active Immediately</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-sm">Save Election</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}