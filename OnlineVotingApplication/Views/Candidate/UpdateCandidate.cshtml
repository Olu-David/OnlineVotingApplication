@model OnlineVotingApplication.DataTransferView.UpdateCandidateViewModel;

@{
    ViewData["Title"] = "Update Candidate Details";
    Layout = "_Layout"; // Admins/Officials Restricted Layout
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <!-- 1. SYSTEM ALERTS BOX (Displays Error Messages from ServiceResponse) -->
            @await Html.PartialAsync("_Alerts");

            <!-- MASTER CARD CONTAINER -->
            <div class="card shadow border-0 rounded-3">

                <!-- CARD HEADER -->
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Update Candidate Profile
                    </h5>
                </div>

                <!-- FORM CONTAINER (Supports Binary Image Uploads) -->
                <!-- enctype="multipart/form-data" is mandatory to process IFormFile CandidateImageUrl streams -->
                <form asp-action="UpdateCandidate" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- CRITICAL HIDDEN AUDIT CONTROLS -->
                    <input type="hidden" asp-for="CandidateID" />
                    <input type="hidden" asp-for="OfficialStaffId" />

                    <!-- ModelOnly means it will cleanly display high-level server/database errors here -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                  
                    <!-- CARD BODY (Main Pre-filled Content Area) -->
                    <div class="card-body p-4">

                        <!-- Input field: Candidate Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Candidate Full Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter full name" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- File Input field: Profile Image File Asset -->
                        <div class="mb-3">
                            <label asp-for="CandidateImageUrl" class="form-label fw-semibold">Upload New Profile Photo</label>
                            <input asp-for="CandidateImageUrl" type="file" class="form-control" accept="image/*" />
                            <div class="form-text text-muted small">Optional. Leave this empty if you want to preserve the candidate's existing picture.</div>
                        </div>

                        <!-- Dropdown list element: Political Party -->
                        <div class="mb-3">
                            <label asp-for="PartyId" class="form-label fw-semibold">Political Party Affiliation</label>
                            <select asp-for="PartyId" class="form-select" asp-items="ViewBag.Parties" required>
                                <option value="">-- Choose Political Party --</option>
                            </select>
                            <span asp-validation-for="PartyId" class="text-danger small"></span>
                        </div>

                        <!-- Dropdown list element: Running Position Office -->
                        <div class="mb-3">
                            <!-- Binds to your exact View Model typo spelling: PositonId -->
                            <label asp-for="PositonId" class="form-label fw-semibold">Target Electoral Position Office</label>
                            <select asp-for="PositonId" class="form-select" asp-items="ViewBag.Positions" required>
                                <option value="">-- Choose Target Office --</option>
                            </select>
                            <span asp-validation-for="PositonId" class="text-danger small"></span>
                        </div>

                        <!-- Dropdown list element: State Constituency Boundaries -->
                        <div class="mb-3">
                            <label asp-for="StateId" class="form-label fw-semibold">State / Region Constituency</label>
                            <select asp-for="StateId" class="form-select" asp-items="ViewBag.States" required>
                                <option value="">-- Choose Region State --</option>
                            </select>
                            <span asp-validation-for="StateId" class="text-danger small"></span>
                        </div>

                        <!-- Multi-line input element: Policy Manifesto Statement Documents -->
                        <div class="mb-0">
                            <label asp-for="Manifesto" class="form-label fw-semibold">Candidate Manifesto Summary Statement</label>
                            <textarea asp-for="Manifesto" class="form-control" rows="5" placeholder="Write candidate manifesto statement summaries here..." required></textarea>
                            <span asp-validation-for="Manifesto" class="text-danger small"></span>
                        </div>

                    </div>

                    <!-- CARD FOOTER (Controls and Navigation Actions) -->
                    <div class="card-footer bg-light p-3 d-flex justify-content-end gap-2">
                        <!-- Gracefully escapes back to your main paginated overview directory list view -->
                        <a asp-action="AllCandidate" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save2-fill me-1"></i> Save Changes
                        </button>
                    </div>

                </form>

            </div> <!-- /Card -->

        </div>
    </div>
</div>

@section Scripts {
    <!-- Wire up client-side error checking so empty fields reject instantly in the browser without reloading -->
    <partial name="_ValidationScriptsPartial" />
}
