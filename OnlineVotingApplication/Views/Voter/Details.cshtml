@model OnlineVotingApplication.Models.ElectionEvent

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <h2>@Model.Title</h2>
    <p class="text-muted">@Model.Description</p>
    <hr />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (Model.Positions != null && Model.Positions.Any())
    {
        @foreach (var position in Model.Positions)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h4 class="mb-0">@position.Name</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        @if (position.Candidates != null && position.Candidates.Any())
                        {
                            @foreach (var candidate in position.Candidates)
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 border">
                                        <div class="card-body text-center">
                                            <h5 class="card-title">@candidate.Name</h5>
                                            <p class="card-text text-muted">@candidate.Manifesto</p>
                                            <a asp-action="RequestCode"
                                               asp-route-electionId="@Model.Id"
                                               asp-route-candidateId="@candidate.Id"
                                               asp-route-positionId="@position.Id"
                                               class="btn btn-outline-success btn-sm">
                                                Vote for this Candidate
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12">
                                <p class="text-muted">No candidates registered for this position yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">No positions configured for this election yet.</div>
    }

    <a asp-action="Index" asp-route-tenantId="@Model.TenantId" class="btn btn-secondary mt-3">Back to Elections List</a>
</div>