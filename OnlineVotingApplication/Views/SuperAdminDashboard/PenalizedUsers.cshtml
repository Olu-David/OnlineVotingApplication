@model PaginatedListViewModel<UserWithRolesViewModel>
@{
    ViewData["Title"] = "Penalized & Locked Users";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Penalized & Locked Users</h2>
            <p class="text-muted small mb-0">Manage security restrictions, active sanctions, and penalty rollbacks.</p>
        </div>
        <div>
            <a asp-action="AllSystemUsers" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to All Users
            </a>
        </div>
    </div>

    <!-- Success / Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Container -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">User Name</th>
                            <th>Email</th>
                            <th>Roles</th>
                            <th>Lockout Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-secondary me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No Roles</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">
                                            <i class="bi bi-shield-lock-fill me-1"></i> Under Penalty Lockout
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- Button to trigger Lift Penalty Modal -->
                                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#liftModal-@user.Id">
                                            <i class="bi bi-unlock-fill me-1"></i> Lift Penalty
                                        </button>

                                        <!-- Lift Penalty Modal -->
                                        <div class="modal fade text-start" id="liftModal-@user.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="LiftPenalty" method="post">
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        <div class="modal-header bg-success text-white">
                                                            <h5 class="modal-title"><i class="bi bi-unlock-fill me-2"></i>Lift Penalty: @user.UserName</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="alert alert-info small mb-3">
                                                                This action will immediately restore access to the user account, record an audit event, and email a notification to the user.
                                                            </div>
                                                            <div class="mb-3">
                                                                <label for="liftReason-@user.Id" class="form-label fw-bold">Reason for Lifting Penalty</label>
                                                                <textarea class="form-control" id="liftReason-@user.Id" name="liftReason" rows="3" required placeholder="Specify why this restriction is being lifted (e.g., successful appeal, resolved dispute)..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success">Confirm & Restore Access</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-check-circle fs-3 text-success d-block mb-2"></i>
                                    No penalized or restricted accounts found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center bg-white py-3">
                <div class="text-muted small">
                    Showing page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong> (Total penalized: @Model.TotalCount)
                </div>
                <nav aria-label="Penalized User Pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNumber > 1 ? "" : "disabled")">
                            <a class="page-link" asp-action="PenalizedUsers" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" asp-action="PenalizedUsers" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber < Model.TotalPages ? "" : "disabled")">
                            <a class="page-link" asp-action="PenalizedUsers" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>