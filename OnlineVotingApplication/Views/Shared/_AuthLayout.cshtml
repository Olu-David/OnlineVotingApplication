<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Votezy</title>

    <link rel="icon" type="image/svg+xml" href="/vote-yea-119581-3b82f6.svg" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Shared Site Tokens & Styles -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    
    <!-- Auth-Specific Stylesheet matching your css definition -->
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light d-flex flex-column justify-content-center align-items-center min-vh-100 m-0" style="background-color: #f0f2f8 !important;">

    <main class="w-100 flex-grow-1 d-flex flex-column justify-content-center">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>