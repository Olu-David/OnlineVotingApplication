@using OnlineVotingApplication.DataTransferView;
@model PaginatedListViewModel<LgaDTO>;

@{
    ViewData["Title"] = "All Local Government";
    Layout = "_Layout";
    int startItem = (Model.PageNumber - 1) * Model.PageSize + 1;
    int endItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems);
    if (Model.TotalItems == 0) { startItem = 0; endItem = 0; }
}

<div class="container mt-4">
    @await Html.PartialAsync("_Alerts")

    <div class="card shadow-sm border-0 rounded-3">
        <!-- 1. CORRECTED: Properly isolated Header Container Block -->
        <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-medium mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-map-fill"></i>
                <span>All LGAs</span>
            </h5>
        </div>

        <!-- 2. CORRECTED: Moved Card Body out of the header wrapper -->
        <div class="card-body p-3">
            <input type="hidden" name="PageNumber" value="1" />
            <input type="hidden" name="Pagesize" value="@Model.PageSize" />

            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-folder-x display-5 d-block mb-2"></i>
                    <span>No active records found for this page window index.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <!-- Added standard Bootstrap table utility styles -->
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th scope="col" style="width: 10%">Profile</th>
                                <th scope="col" style="width: 60%">LGA Name</th>
                                <th scope="col" style="width: 30%" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <i class="bi bi-geo-fill text-primary fs-5"></i>
                                    </td>

                                    <td>
                                        <span class="fw-medium text-dark">@item.Name</span>
                                    </td>

                                    <td class="pe-3">
                                        <div class="d-flex gap-2 justify-content-center align-items-center">

                                            <a asp-controller="Lga" asp-action="EditLga" asp-route-id="@item.Id"
                                               class="btn btn-outline-warning btn-sm d-flex align-items-center justify-content-center gap-1">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>

                                            <!-- SOFT-DELETE ACTION FORM -->
                                            <form asp-controller="Lga" asp-action="ConfirmDelete" method="post" class="m-0">
                                                @Html.AntiForgeryToken()

                                                <!-- Hidden field named exactly candidateId matching controller input -->
                                                <input type="hidden" name="candidateId" value="@item.Id" />

                                                <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center justify-content-center gap-1"
                                                        onclick="return confirm('⚠️ SOFT-DELETE CONFIRMATION:\n\nAre you sure you want to delete @item.Name?');">
                                                    <i class="bi bi-trash3-fill"></i> Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
