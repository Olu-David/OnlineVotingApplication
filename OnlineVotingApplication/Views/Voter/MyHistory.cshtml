@model List<OnlineVotingApplication.Models.ElectionEvent>

@{
    ViewData["Title"] = "My Voting History";
}

@section Styles {
    <link rel="stylesheet" href="/css/voter.css" asp-append-version="true" />
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h1 class="mb-1" style="font-family: var(--votex-font-display); font-weight: 600; color: var(--votex-navy-900);">
            <i class="fas fa-history me-2" style="color: var(--votex-amber);"></i>My Voting History
        </h1>
        <p class="text-muted mb-0">Elections you've participated in.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">You have not participated in any election events yet.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: var(--votex-navy-900); color: #fff;">
                        <tr>
                            <th class="ps-4">Election</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-end pe-4">Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var election in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold" style="color: var(--votex-navy-900);">@election.Title</span>
                                </td>
                                <td class="text-muted small">@election.StartDate.ToString("MMM d, yyyy")</td>
                                <td class="text-muted small">@election.EndDate.ToString("MMM d, yyyy")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="BallotBreakdown" asp-route-electionId="@election.Id" class="btn btn-sm btn-outline-dark rounded-pill">
                                        <i class="fas fa-receipt me-1"></i> View Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
