@using OnlineVotingApplication.DataTransferView;
@model LgaDTO;

@{
    ViewData["Title"] = "Create LGA";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Correctly Wrapped Bootstrap Card Container Block -->
            <div class="card shadow border-0 rounded-3">

                <!-- Explicit Header Banner Block -->
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="card-title mb-0 fw-semibold text-uppercase small tracking-wider">
                        <i class="fas fa-map-marker-alt me-2"></i>Create Local Government Area
                    </h5>
                </div>

                <!-- Card Body Form Padding Wrapper -->
                <div class="card-body p-4">

                    <form asp-controller="Lga" asp-action="CreateLga" method="post" id="createLgaForm">
                        @Html.AntiForgeryToken()

                        <!-- Model Validation Container Wrapper -->
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- Optimized State Dropdown Form Field -->
                        <div class="mb-4">
                            <label asp-for="StateId" class="form-label fw-semibold small text-muted text-uppercase">State Context</label>
                            <select asp-for="StateId" class="form-select py-2" asp-items="ViewBag.State">
                                <option value="">-- Select State --</option>
                            </select>
                            <span asp-validation-for="StateId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Polished LGA Text Field Box -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold small text-muted text-uppercase">LGA Title Name</label>
                            <input type="text" asp-for="Name" class="form-control py-2" placeholder="e.g., Ikeja, Gwale, AMAC" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <hr class="my-4 border-light" />

                        <!-- Perfectly Blocked Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" asp-controller="Lga" class="btn btn-light border px-4 py-2">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2" id="submitBtn">
                                <i class="fas fa-save me-1"></i> Create LGA
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Replaced CDNs with standard local app partial scripts for faster offline compilation -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        // UX Enhancement: Prevent duplicate submissions on slow connections
        document.getElementById('createLgaForm').addEventListener('submit', function (e) {
            if ($(this).valid()) {
                const btn = document.getElementById('submitBtn');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
            }
        });
    </script>
}
