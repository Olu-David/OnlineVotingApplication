@using Microsoft.AspNetCore.Identity
@using OnlineVotingApplication.Areas.Identity.Data
@using OnlineVotingApplication.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    // ─── ROLE & AUTH STATE ──────────────────────────────────────────
    bool isAuth = User?.Identity?.IsAuthenticated ?? false;
    bool isSuperAdmin = isAuth && User!.IsInRole("SuperAdmin");
    bool isOfficial = isAuth && User!.IsInRole("Official");
    bool isAuditor = isAuth && User!.IsInRole("Auditor");
    bool isCandidate = isAuth && User!.IsInRole("Candidate");
    bool isVoter = isAuth && User!.IsInRole("Voter");
    bool isBlocked = isAuth && !(isSuperAdmin || isOfficial || isAuditor || isCandidate || isVoter);

    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string dashCtrl = isVoter ? "Voter"
                    : isOfficial ? "Official"
                    : isAuditor ? "Auditor"
                    : isSuperAdmin ? "SuperAdmin"
                    : isCandidate ? "Candidate"
                    : "Home";

    string nameInitial = (isAuth && !string.IsNullOrEmpty(User?.Identity?.Name))
                       ? User!.Identity!.Name![0].ToString().ToUpper()
                       : "?";

    string roleBadge = isSuperAdmin ? "SuperAdmin"
                     : isOfficial ? "Official"
                     : isAuditor ? "Auditor"
                     : isCandidate ? "Candidate"
                     : isVoter ? "Voter"
                     : "";

    string roleColor = isSuperAdmin ? "danger"
                     : isOfficial ? "primary"
                     : isAuditor ? "warning"
                     : isCandidate ? "info"
                     : isVoter ? "success"
                     : "secondary";

    // ─── PASS DATA TO PARTIALS ─────────────────────────────────────
    ViewData["IsAuth"] = isAuth;
    ViewData["IsSuperAdmin"] = isSuperAdmin;
    ViewData["IsOfficial"] = isOfficial;
    ViewData["IsAuditor"] = isAuditor;
    ViewData["IsCandidate"] = isCandidate;
    ViewData["IsVoter"] = isVoter;
    ViewData["IsBlocked"] = isBlocked;
    ViewData["DashCtrl"] = dashCtrl;
    ViewData["Ctrl"] = ctrl;
    ViewData["Action"] = action;
    ViewData["NameInitial"] = nameInitial;
    ViewData["RoleBadge"] = roleBadge;
    ViewData["RoleColor"] = roleColor;
    ViewData["User"] = User;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — VoteX</title>

    <link rel="icon" type="image/svg+xml" href="/vote-yea-119581-3b82f6.svg" asp-append-version="true" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/navbar.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(isSuperAdmin ? "vx-admin-body" : "vx-public-body")">

    @if (isSuperAdmin)
    {
        <div class="admin-shell d-flex w-100" style="max-width: 100vw; height: 100vh; overflow: hidden;">

            <!-- SIDEBAR -->
            @await Html.PartialAsync("_SuperAdminSidebar")

            <!-- MAIN COLUMN -->
            <div class="d-flex flex-column flex-grow-1" style="min-width: 0; height: 100vh; overflow: hidden;">

                @* <!-- TOPBAR -->
                @await Html.PartialAsync("_AdminTopbar") *@

                <!-- SCROLLABLE CONTENT AREA -->
                <div class="flex-grow-1" style="overflow-y: auto; overflow-x: hidden; height: 100%;">
                    <main class="admin-content p-4" style="min-height: 100%; padding-bottom: 5rem !important;">
                        @await Html.PartialAsync("_Alerts")
                        @if (!isBlocked)
                        {
                            @RenderBody()
                        }
                    </main>
                </div>

            </div>
        </div>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    }

   
    else
    {
        <!-- PUBLIC NAVBAR -->
        @await Html.PartialAsync("_Navbar")

        <main class="flex-grow-1">
            <div class="container py-4">
                @await Html.PartialAsync("_Alerts")
                @if (!isBlocked)
                {
                    @RenderBody()
                }
            </div>
        </main>

        <!-- FOOTER -->
        @await Html.PartialAsync("_Footer")
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <script src="/js/navbar.js" asp-append-version="true"></script>
    <script src="/js/sidebar.js" asp-append-version="true"></script>
    <script src="/js/alerts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>