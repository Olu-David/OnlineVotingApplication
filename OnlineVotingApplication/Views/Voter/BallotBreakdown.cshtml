@model List<OnlineVotingApplication.Models.Vote>

@{
    ViewData["Title"] = "Ballot Breakdown Receipt";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>🗳️ Ballot Breakdown Receipt</h2>
            <p class="text-muted">Audit trail of your confirmed candidate selections for this election.</p>
        </div>
        <div>
            <a asp-action="MyHistory" class="btn btn-secondary btn-sm">Back to History</a>
        </div>
    </div>
    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">
            No ballot data found for this election event.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Position</th>
                                <th>Selected Candidate</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vote in Model)
                            {
                                <tr>
                                    <td><strong>@(vote.Positions?.Name ?? "N/A")</strong></td>   <!-- Fixed: Position (singular) -->
                                    <td>
                                        @if (vote.Candidate != null)
                                        {
                                            <span class="text-success fw-bold">@vote.Candidate.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Candidate record unavailable</span>
                                        }
                                    </td>
                                    <td>
                                        @if (vote.HasVoted)
                                        {
                                            <span class="badge bg-success">Cast & Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>