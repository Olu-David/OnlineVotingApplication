@using OnlineVotingApplication.DataTransferView;
@model IEnumerable<CandidateVoteDto>
@{
    ViewData["Title"] = "Live Results";

    bool canViewResults = ViewData["CanViewResults"] is bool val && val;
    bool isVoter = ViewData["IsVoter"] is bool v && v;
    bool isManagement = ViewData["IsManagement"] is bool m && m;
    Guid electionEventId = ViewData["ElectionEventId"] is Guid id ? id : Guid.Empty;

    var results = Model?.OrderByDescending(c => c.VoteCount).ToList() ?? new List<CandidateVoteDto>();
    int maxVotes = results.Any() ? results.Max(c => c.VoteCount) : 0;
    int totalVotes = results.Sum(c => c.VoteCount);
}

@section Styles {
    <link rel="stylesheet" href="/css/voter.css" asp-append-version="true" />
}

<div class="container mt-4 mb-5">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="mb-1"
                style="font-family: var(--votex-font-display); font-weight: 600; color: var(--votex-navy-900);">
                <i class="fas fa-chart-line me-2" style="color: var(--votex-amber);"></i>Live Results
            </h1>
            <p class="text-muted mb-0">Real-time tally across all candidates.</p>
        </div>

        @if (canViewResults)
        {
            <div class="d-flex gap-2">
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2">
                    <i class="fas fa-circle-dot me-1"></i>Live
                </span>
                <span class="badge bg-light text-dark border px-3 py-2">
                    <i class="fas fa-check-to-slot me-1"></i>@totalVotes total votes
                </span>
            </div>
        }
    </div>

    <!-- ROLE BANNER (optional) -->
    @if (isManagement && canViewResults)
    {
        <div class="alert alert-primary d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="fas fa-user-shield"></i>
            <div>You're viewing live results with management privileges.</div>
        </div>
    }

    <!-- ACCESS GATE — VOTERS ONLY -->
    @if (!canViewResults && isVoter)
    {
        <div class="row justify-content-center my-5">
            <div class="col-md-8 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <div class="card-body py-4">

                        <div class="mb-3 display-4" style="color: var(--votex-amber);">
                            <i class="fas fa-lock"></i>
                        </div>

                        <h3 class="fw-bold mb-3"
                            style="font-family: var(--votex-font-display); color: var(--votex-navy-900);">
                            Ballot Submission Required
                        </h3>

                        <p class="text-muted mb-4 small"
                           style="font-size: 0.95rem; line-height: 1.6;">
                            To maintain election transparency and prevent bias, you must cast your vote in this
                            election event before you can unlock and view the live monitoring charts.
                        </p>

                        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                            <a asp-controller="Voter" asp-action="Details" asp-route-id="@electionEventId"
                               class="btn text-dark fw-bold px-4 py-2 rounded-pill shadow-sm"
                               style="background-color: var(--votex-amber);">
                                <i class="fas fa-vote-yea me-2"></i>Cast Your Vote Now
                            </a>
                            <a asp-controller="Voter" asp-action="Index"
                               class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                                Back to Dashboard
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
    else if (canViewResults)
    {
        <!-- RESULTS -->
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase small fw-bold text-muted mb-3"
                            style="font-family: var(--votex-font-mono); letter-spacing: 0.05em;">
                            Vote Tally Chart
                        </h6>
                        <canvas id="liveResultsChart" height="260"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase small fw-bold text-muted mb-3"
                            style="font-family: var(--votex-font-mono); letter-spacing: 0.05em;">
                            Leaderboard
                        </h6>

                        @if (!results.Any())
                        {
                            <p class="text-muted small">No votes recorded yet.</p>
                        }
                        else
                        {
                            @for (int i = 0; i < results.Count; i++)
                            {
                                var c = results[i];
                                double pct = maxVotes > 0 ? (double)c.VoteCount / maxVotes * 100 : 0;

                                <div class="result-bar-row @(i == 0 && c.VoteCount > 0 ? "is-leading" : "")">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-semibold" style="color: var(--votex-navy-900);">
                                            #@(i + 1) @c.CandidateName
                                            @if (i == 0 && c.VoteCount > 0)
                                            {
                                                <span class="badge rounded-pill ms-1"
                                                      style="background: var(--votex-green); font-size: 0.65rem;">
                                                    Leading
                                                </span>
                                            }
                                        </span>
                                        <span class="text-muted">@c.VoteCount votes</span>
                                    </div>
                                    <div class="result-bar-track">
                                        <div class="result-bar-fill" style="width: @pct.ToString("0")%;"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (canViewResults)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const candidateNames = @Json.Serialize(results.Select(c => c.CandidateName));
            const voteCounts = @Json.Serialize(results.Select(c => c.VoteCount));

            const ctx = document.getElementById('liveResultsChart');
            if (ctx) {
                new Chart(ctx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: candidateNames,
                        datasets: [{
                            label: 'Votes Cast',
                            data: voteCounts,
                            backgroundColor: '#f5a623',
                            borderColor: '#0f1a38',
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            }
        </script>
    }
}