@{
    Layout = null;
    string userName = User?.Identity?.Name ?? "User";
    string initial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";
}

<!-- The floating mobile toggle and backdrop overlay are rendered once in
     _Layout.cshtml (shared with _SuperAdminSidebar) so both roles use the
     exact same toggle/overlay instance instead of duplicate ids. -->

<nav class="admin-sidebar admin-sidebar--official bg-dark text-white d-flex flex-column p-3 flex-shrink-0" id="adminSidebar">
    <!-- Brand -->
    <div class="sidebar-brand d-flex align-items-center gap-2 mb-3">
        <div class="brand-icon"><i class="fas fa-vote-yea"></i></div>
        <div class="brand-text">
            <span class="d-block fw-bold">VoteZy</span>
            <small class="text-white-50">Election Office</small>
        </div>

        <!-- Large-screen-only collapse-to-icons toggle -->
        <button class="btn btn-sm btn-outline-light border-0 ms-auto d-none d-lg-inline-flex" id="sidebarCollapseToggle"
                type="button" aria-label="Collapse sidebar">
            <i class="fas fa-angles-left"></i>
        </button>
    </div>

    <div class="sidebar-punch-rule"></div>

    <!-- User chip -->
    <div class="sidebar-user d-flex align-items-center gap-2 p-2 mb-3">
        <span class="avatar-sm">@initial</span>
        <div class="sidebar-user-info small">
            <div class="fw-semibold">@userName</div>
            <div class="sidebar-role-badge">Election Official</div>
        </div>
    </div>

    <hr class="border-secondary opacity-25" />

    <!-- Navigation -->
    <ul class="nav flex-column flex-grow-1">

        <li class="sidebar-section-label">Overview</li>
        <li class="nav-item">
            <a asp-controller="Tenant" asp-action="Dashboard"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-tachometer-alt me-2"></i><span>Dashboard</span>
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Tenant" asp-action="ManageUsers"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "ManageUsers" ? "active" : "")">
                <i class="fas fa-users-gear me-2"></i><span>Manage Admins</span>
            </a>
        </li>

        <li class="sidebar-section-label">Election Management</li>

        <!-- Election Analytics / Live Results -->
        <li class="nav-item">
            <a asp-controller="Voter" asp-action="LiveResults"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Vote" && ViewData["Action"]?.ToString() == "LiveResults" ? "active" : "")">
                <i class="fas fa-chart-line me-2"></i><span>Election Analytics</span>
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Vote" asp-action="ManualEntry"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Vote" && ViewData["Action"]?.ToString() == "ManualEntry" ? "active" : "")">
                <i class="fas fa-file-pen me-2"></i><span>Manual Entry</span>
            </a>
        </li>

        <!-- Candidates Management Dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white @(ViewData["Ctrl"]?.ToString() == "Candidate" ? "active" : "")"
               href="#"
               id="candidatesDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <i class="fas fa-user-tie me-2"></i><span>Candidates</span>
            </a>

            <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="candidatesDropdown">
                <li>
                    <a asp-controller="Candidate"
                       asp-action="AllCandidate"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "AllCandidate" ? "active" : "")">
                        <i class="fas fa-list me-2"></i>All Candidates
                    </a>
                </li>
                <!-- Added Pending Candidate Applications Queue Link -->
                <li>
                    <a asp-controller="Candidate"
                       asp-action="PendingApplications"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "PendingApplications" ? "active" : "")">
                        <i class="fas fa-clipboard-list me-2 text-warning"></i>Pending Applications
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a asp-controller="Tenant"
                       asp-action="CreateCandidateOfficial"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "Tenant" && ViewData["Action"]?.ToString() == "CreateCandidateOfficial" ? "active" : "")">
                        <i class="fas fa-user-plus me-2"></i>Create Candidate (Official)
                    </a>
                </li>
            </ul>
        </li>

        <!-- Elections Management Dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" ? "active" : "")"
               href="#"
               id="electionsDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <i class="fas fa-calendar-alt me-2"></i><span>Elections</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="electionsDropdown">
                <li>
                    <a asp-controller="ElectionEvent" asp-action="Index"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-list me-2"></i>All Elections
                    </a>
                </li>
                <li>
                    <a asp-controller="ElectionEvent" asp-action="Create"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" && ViewData["Action"]?.ToString() == "Create" ? "active" : "")">
                        <i class="fas fa-plus-circle me-2"></i>Create Election
                    </a>
                </li>
                <li>
                    <a asp-controller="ElectionEvent" asp-action="Edit"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" && ViewData["Action"]?.ToString() == "Edit" ? "active" : "")">
                        <i class="fas fa-pen-to-square me-2"></i>Edit Election
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a asp-controller="ElectionEvent" asp-action="Delete"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "ElectionEvent" && ViewData["Action"]?.ToString() == "Delete" ? "active" : "")">
                        <i class="fas fa-trash me-2"></i>Delete Election
                    </a>
                </li>
            </ul>
        </li>

        <!-- Positions Management Dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white @(ViewData["Ctrl"]?.ToString() == "Position" ? "active" : "")"
               href="#"
               id="positionsDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <i class="fas fa-bullseye me-2"></i><span>Positions</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="positionsDropdown">
                <li>
                    <a asp-controller="Position" asp-action="Index"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "Position" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-list me-2"></i>All Positions
                    </a>
                </li>
                <li>
                    <a asp-controller="Position" asp-action="Create"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "Position" && ViewData["Action"]?.ToString() == "Create" ? "active" : "")">
                        <i class="fas fa-plus-circle me-2"></i>Create Position
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a asp-controller="Position" asp-action="GetAllSoftDelete"
                       class="dropdown-item @(ViewData["Ctrl"]?.ToString() == "Position" && ViewData["Action"]?.ToString() == "GetAllSoftDelete" ? "active" : "")">
                        <i class="fas fa-trash-alt me-2"></i>Trash / Deleted
                    </a>
                </li>
            </ul>
        </li>

        <!-- Tenant Form Designer / Form Customization -->
        <li class="nav-item mt-2">
            <a asp-controller="TenantFormDesigner" asp-action="Index"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "TenantFormDesigner" ? "active" : "")">
                <i class="fas fa-wand-magic-sparkles me-2"></i><span>Form Designer</span>
            </a>
        </li>

        <!-- Security & Access Control Section -->
        <li class="sidebar-section-label">Security & Oversight</li>

        <!-- All System Users -->
        <li class="nav-item">
            <a asp-controller="SuperAdminDashboard" asp-action="AllSystemUsers"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "SuperAdminDashboard" && ViewData["Action"]?.ToString() == "AllSystemUsers" ? "active" : "")">
                <i class="fas fa-users me-2"></i><span>All System Users</span>
            </a>
        </li>

        <!-- Penalized / Locked Users -->
        <li class="nav-item">
            <a asp-controller="SuperAdminDashboard" asp-action="PenalizedUsers"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "SuperAdminDashboard" && ViewData["Action"]?.ToString() == "PenalizedUsers" ? "active" : "")">
                <i class="fas fa-user-lock me-2 text-danger"></i><span>Penalized Users</span>
            </a>
        </li>

        <!-- Audit Logs -->
        <li class="nav-item">
            <a asp-controller="AuditLog" asp-action="Index"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "AuditLog" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-clipboard-list me-2"></i><span>Audit Logs</span>
            </a>
        </li>

        <!-- Support Service -->
        <li class="nav-item mt-2">
            <a asp-controller="Support" asp-action="Index"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Support" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-headset me-2"></i><span>Support Service</span>
            </a>
        </li>

    </ul>
</nav>