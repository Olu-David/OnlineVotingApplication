@model OnlineVotingApplication.DataTransferView.ManualResultViewModel;
@{
    ViewData["Title"] = "Manual Vote Entry";
    var elections = ViewBag.Elections as List<OnlineVotingApplication.Models.ElectionEvent> ?? new();
    var positions = ViewBag.Positions as List<OnlineVotingApplication.Models.Positions> ?? new();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Page Header Card -->
            <div class="card shadow-sm border-0 mb-4" style="border-left: 4px solid #f5a623 !important;">
                <div class="card-body bg-light">
                    <h2 class="h4 fw-bold text-dark mb-1">
                        <i class="fas fa-edit me-2 text-warning"></i>Manual Vote Management
                    </h2>
                    <p class="text-muted small mb-0">
                        Select an election and position to adjust candidate vote counts. Enter positive numbers to add votes or negative numbers (e.g., -5) to subtract votes.
                    </p>
                </div>
            </div>

            <!-- Success/Error Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Step 1: Filter Form -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <form method="get" asp-action="ManualEntry" class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Election Event</label>
                            <select name="electionId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- Choose Election --</option>
                                @foreach (var el in elections)
                                {
                                    if (Model.ElectionEventId == el.Id)
                                    {
                                        <option value="@el.Id" selected>@el.Title</option>
                                    }
                                    else
                                    {
                                        <option value="@el.Id">@el.Title</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Position</label>
                            <select name="positionId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- Choose Position --</option>
                                @foreach (var pos in positions)
                                {
                                    if (Model.PositionId == pos.Id)
                                    {
                                        <option value="@pos.Id" selected>@pos.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@pos.Id">@pos.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <noscript>
                                <button type="submit" class="btn btn-dark btn-sm w-100">Load</button>
                            </noscript>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Step 2: Candidate Adjustment Form -->
            @if (Model.CandidateVotes != null && Model.CandidateVotes.Any())
            {
                <form asp-action="ManualEntry" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ElectionEventId" />
                    <input type="hidden" asp-for="PositionId" />

                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0 fw-bold text-primary">Candidate Adjustments</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Candidate Name</th>
                                            <th class="text-end pe-4" style="width: 200px;">Adjustment Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.CandidateVotes.Count; i++)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <input type="hidden" asp-for="CandidateVotes[i].CandidateId" />
                                                    <input type="hidden" asp-for="CandidateVotes[i].CandidateName" />
                                                    <span class="fw-semibold text-dark">@Model.CandidateVotes[i].CandidateName</span>
                                                </td>
                                                <td class="pe-4">
                                                    <input type="number" asp-for="CandidateVotes[i].ManualVoteCount" class="form-control form-control-sm text-end" placeholder="0" />
                                                    <span asp-validation-for="CandidateVotes[i].ManualVoteCount" class="text-danger small"></span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="fas fa-info-circle me-1"></i> Use negative values to safely remove votes.</span>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark shadow-sm">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            }
            else if (Model.ElectionEventId != Guid.Empty && Model.PositionId != Guid.Empty)
            {
                <div class="alert alert-warning text-center py-4" role="alert">
                    <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                    <p class="mb-0">No active candidates found for the selected election and position combination.</p>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}