@model OnlineVotingApplication.DataTransferView.SendCandidateInvitation

<div class="card shadow-sm mb-4 border-0 rounded-3 overflow-hidden">
    <div class="card-header candform-header p-3">
        <h5><i class="bi bi-envelope-paper me-2" style="color: var(--votex-amber);"></i>Send Candidate Invitation</h5>
    </div>
    <div class="card-body p-4">
        <form asp-controller="Candidate" asp-action="SendCandidateInvite" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="electionEventId" value="@Model.ElectionEventId" />

            <div class="mb-3">
                <label for="candidateEmail" class="form-label fw-semibold">Candidate Email Address</label>
                <input type="email" class="form-control" id="candidateEmail" name="candidateEmail" placeholder="candidate@example.com" required />
            </div>

            <button type="submit" class="btn candform-submit">
                <i class="bi bi-envelope-paper me-1"></i> Send Secure Invitation Link
            </button>
        </form>
    </div>
</div>
