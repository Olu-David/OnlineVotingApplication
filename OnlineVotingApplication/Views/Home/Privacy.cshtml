<!-- Support & Contact Form Section -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white" id="support-form-section">
    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Get in Touch</span>
        <h4 class="fw-bold text-dark">Support & Inquiry Form</h4>
        <p class="text-muted small">Need assistance with your ballot, registration, or tenant setup? Send us a message.</p>
    </div>

    @if (TempData["SupportSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SupportSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Home" asp-action="SubmitSupport" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small">Your Name</label>
                <input type="text" name="Name" class="form-control rounded-3" placeholder="Enter your full name" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small">Email Address</label>
                <input type="email" name="Email" class="form-control rounded-3" placeholder="name@example.com" required />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold text-secondary small">Subject / Inquiry Type</label>
                <select name="Subject" class="form-select rounded-3" required>
                    <option value="" selected disabled>Select an option...</option>
                    <option value="Voter Registration Issue">Voter Registration Issue</option>
                    <option value="Ballot / Stub Verification">Ballot / Stub Verification</option>
                    <option value="Candidate Portal Support">Candidate Portal Support</option>
                    <option value="Tenant / System Administration">Tenant / System Administration</option>
                    <option value="General Inquiry">General Inquiry</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold text-secondary small">Message</label>
                <textarea name="Message" rows="4" class="form-control rounded-3" placeholder="Describe your issue or question in detail..." required></textarea>
            </div>
            <div class="col-12 text-end mt-4">
                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm">
                    <i class="fas fa-paper-plane me-2"></i>Send Message
                </button>
            </div>
        </div>
    </form>
</div>