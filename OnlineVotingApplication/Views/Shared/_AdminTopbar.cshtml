@{
    Layout = null;
}

<nav class="admin-topbar d-flex align-items-center justify-content-between px-3">

    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-light" id="sidebarToggle" type="button">
            <i class="fas fa-bars"></i>
        </button>
        <span class="fw-semibold text-secondary">@ViewData["Title"]</span>
    </div>

    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-light position-relative" type="button">
            <i class="fas fa-bell"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;">
                3
            </span>
        </button>

        <div class="dropdown">
            <button class="btn btn-light d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                <span class="avatar-sm">@ViewData["NameInitial"]</span>
                <span class="d-none d-md-inline">@User?.Identity?.Name</span>
                <i class="fas fa-chevron-down small"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><span class="dropdown-item-text fw-semibold">@User?.Identity?.Name</span></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i>Logout</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>