@using OnlineVotingApplication.DataTransferView
@model PaginatedListViewModel<CandidateViewModel>

@{
    ViewData["Title"] = "Candidates Directory";
    Layout = "_Layout"; // Admins/Officials only
}

@section Styles {
    <link rel="stylesheet" href="/css/candidate.css" asp-append-version="true" />
}

<div class="container mt-4">

    <!-- SYSTEM ALERTS BOX -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- MASTER TABLE LAYOUT WRAPPED IN A DESIGN CARD -->
    <div class="card candmgmt-card">
        <div class="candmgmt-header">
            <h5><i class="bi bi-people-fill me-2"></i>Candidates Directory</h5>
        </div>

        <div class="card-body p-0">
            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-folder-x display-5 d-block mb-2"></i>
                    <span>No active records found for this page.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th scope="col" class="ps-3" style="width: 70px;">Profile</th>
                                <th scope="col">Candidate</th>
                                <th scope="col">Party</th>
                                <th scope="col">Position</th>
                                <th scope="col">State</th>
                                <th scope="col" class="text-center" style="width: 240px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <!-- Image Avatar -->
                                    <td class="ps-3">
                                        <img src="@(string.IsNullOrEmpty(item.image) ? "/images/default-avatar.png" : item.image)"
                                             alt="@item.Name"
                                             class="candmgmt-avatar" />
                                    </td>

                                    <!-- Details -->
                                    <td>
                                        <div class="candmgmt-name">@item.Name</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 260px;">@item.Manifesto</small>
                                    </td>
                                    <td><span class="badge candmgmt-party-badge">@item.PartyName</span></td>
                                    <td><span class="text-secondary fw-semibold">@item.Position</span></td>
                                    <td><i class="bi bi-geo-alt text-muted"></i> @item.StateName</td>

                                    <!-- Action Operations Column with Side-by-Side Flex Layout -->
                                    <td class="pe-3">
                                        <div class="d-flex justify-content-center align-items-center gap-2">

                                            <!-- EDIT ACTION BUTTON -->
                                            <a asp-action="Edit" asp-route-id="@item.CandidateID"
                                               class="btn btn-outline-warning btn-sm d-flex align-items-center justify-content-center gap-1 flex-grow-1">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>

                                            <!-- SOFT-DELETE ACTION FORM -->
                                            <form asp-action="ConfirmSoftDelete" method="post" class="m-0 flex-grow-1"
                                                  onsubmit="return confirm('⚠️ SOFT-DELETE CONFIRMATION:\n\nAre you sure you want to move @item.Name to the Trash Bin?\n\nYou will have 30 days to restore this profile before it is automatically destroyed.');">
                                                @Html.AntiForgeryToken()

                                                <!-- Hidden configuration mappings directly tied to pagination properties -->
                                                <input type="hidden" name="candidateId" value="@item.CandidateID" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-1">
                                                    <i class="bi bi-trash3-fill"></i> Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- STABLE FOOTER ROUTING NAVIGATION -->
        <div class="card-footer bg-white p-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Viewing Page <strong>@Model.PageNumber</strong></span>
            <nav aria-label="Candidates page navigation">
                <ul class="pagination pagination-sm mb-0">

                    <!-- Previous Page Link Button -->
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="AllCandidate"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize">Previous</a>
                    </li>

                    <!-- Current Status Indicator -->
                    <li class="page-item active">
                        <span class="page-link">@Model.PageNumber</span>
                    </li>

                    <!-- Next Page Link Button -->
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="AllCandidate"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>
