@{
    Layout = null;
}
<footer class="text-white-50 mt-5 pt-3" style="background: #111e3c;">
    <div class="container">
        <div class="row g-4 py-4">

            <!-- Brand Info -->
            <div class="col-md-4">
                <div class="fw-bold h5 text-white">
                    <i class="fas fa-vote-yea me-2"></i> VoteX
                </div>
                <p class="small">
                    Secure, transparent and real-time digital voting platform built for trust and integrity.
                </p>
            </div>

            <!-- Navigation Links -->
            <div class="col-md-4">
                <h6 class="fw-bold text-white">Quick Links</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Home</a></li>
                    <li class="mb-2"><a asp-controller="Results" asp-action="LiveCount" class="text-white-50 text-decoration-none">Live Results</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none">Privacy Policy</a></li>
                </ul>
            </div>

            <!-- Support Details -->
            <div class="col-md-4">
                <h6 class="fw-bold text-white">Support</h6>
                <ul class="list-unstyled small text-white-50">
                    <li class="mb-2"><i class="fas fa-envelope me-2"></i> support@votex.ng</li>
                    <li class="mb-2"><i class="fas fa-phone me-2"></i> 08056517525</li>
                    <li><i class="fas fa-circle-dot me-2 text-success pulse-dot"></i> 24/7 Monitoring</li>
                </ul>
            </div>

        </div>

        <hr class="border-white border-opacity-10 my-2" />

        <!-- Bottom Bar -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pb-3 small">
            <span>&copy; <span id="currentYear"></span> VoteX. All rights reserved.</span>
            <span>Built for secure digital democracy ⚡</span>
        </div>
    </div>
</footer>

<!-- Tiny inline script to dynamic-load the current year safely -->
<script>
    document.getElementById("currentYear").textContent = new Date().getFullYear();
</script>