@{
    Layout = null;
}
@using Microsoft.AspNetCore.Identity
@using OnlineVotingApplication.Areas.Identity.Data
@inject SignInManager<ApplicationUser> SignInManager

<!-- The floating mobile toggle and backdrop overlay are rendered once in
     _Layout.cshtml (shared with _OfficialSidebar) so both roles use the
     exact same toggle/overlay instance instead of duplicate ids. -->

<nav class="admin-sidebar admin-sidebar--superadmin bg-dark text-white d-flex flex-column p-3 flex-shrink-0" id="adminSidebar">
    <!-- Brand -->
    <div class="sidebar-brand d-flex align-items-center gap-2 mb-3">
        <div class="brand-icon"><i class="fas fa-vote-yea"></i></div>
        <div class="brand-text">
            <span class="d-block fw-bold">Votezy</span>
            <small class="text-white-50">Super Admin</small>
        </div>

        <!-- Large-screen-only collapse-to-icons toggle -->
        <button class="btn btn-sm btn-outline-light border-0 ms-auto d-none d-lg-inline-flex" id="sidebarCollapseToggle"
                type="button" aria-label="Collapse sidebar">
            <i class="fas fa-angles-left"></i>
        </button>
    </div>

    <div class="sidebar-punch-rule"></div>

    <!-- User chip -->
    <div class="sidebar-user d-flex align-items-center gap-2 p-2 mb-3">
        <span class="avatar-sm">@ViewData["NameInitial"]</span>
        <div class="sidebar-user-info small">
            <div class="fw-semibold">@User?.Identity?.Name</div>
            <div class="sidebar-role-badge">Administrator</div>
        </div>
    </div>

    <hr class="border-secondary opacity-25" />

    <!-- Navigation -->
    <ul class="nav flex-column flex-grow-1">

        <li class="sidebar-section-label">Overview</li>
        <li class="nav-item">
            <a asp-controller="SuperAdminDashboard" asp-action="Dashboard"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "SuperAdminDashboard" && ViewData["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-tachometer-alt me-2"></i><span>Dashboard</span>
            </a>
        </li>
        <!-- Live Results -->
        <li class="nav-item">
            <a asp-controller="Vote" asp-action="LiveResults"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Vote" && ViewData["Action"]?.ToString() == "LiveResults" ? "active" : "")">
                <i class="fas fa-chart-bar me-2"></i><span>Live Results</span>
            </a>
        </li>

        <li class="sidebar-section-label">Election Management</li>

        <!-- Collapsible Elections -->
        <li class="nav-item">
            <a href="#electionMenu" class="nav-link text-white d-flex align-items-center justify-content-between"
               data-bs-toggle="collapse" aria-expanded="false">
                <span><i class="fas fa-calendar-alt me-2"></i> Elections</span>
                <i class="fas fa-chevron-down small"></i>
            </a>
            <div class="collapse" id="electionMenu">
                <ul class="nav flex-column ms-3">
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="Index"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Election" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="fas fa-list me-2"></i><span>All Elections</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="Create"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Election" && ViewData["Action"]?.ToString() == "Create" ? "active" : "")">
                            <i class="fas fa-plus-circle me-2"></i><span>Create</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ElectionEvent" asp-action="SoftDeleted"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Election" && ViewData["Action"]?.ToString() == "SoftDeleted" ? "active" : "")">
                            <i class="fas fa-trash-alt me-2"></i><span>Deleted</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- Collapsible Candidates -->
        <li class="nav-item">
            <a href="#CandidateMenu" class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "Candidate" ? "active" : "")"
               data-bs-toggle="collapse" aria-expanded="false" aria-label="CandidateDropMenu">
                <span><i class="fas fa-user-tie me-2"></i> Candidates</span>
                <i class="fas fa-chevron-down small"></i>
            </a>
            <div class="collapse" id="CandidateMenu">
                <ul class="nav flex-column ms-3">
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="AllCandidate"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "AllCandidate" ? "active" : "")">
                            <i class="fas fa-list me-2"></i><span>All Candidates</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="SuperAdminDashboard" asp-action="BuildGlobalForm"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "SuperAdminDashboard" && ViewData["Action"]?.ToString() == "BuildGlobalForm" ? "active" : "")">
                            <i class="fas fa-list me-2"></i><span>Build Global Form</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="CreateCandidate"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "CreateCandidate" ? "active" : "")">
                            <i class="fas fa-plus-circle me-2"></i><span>Create</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="GetCandidateByState"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "GetCandidateByState" ? "active" : "")">
                            <i class="fas fa-map-marker-alt me-2"></i><span>All Candidate By State</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="GetCandidateByLga"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "GetCandidateByLga" ? "active" : "")">
                            <i class="fas fa-map-marker-alt me-2"></i><span>All Candidate By Lga</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Candidate" asp-action="GetCandidateByParty"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Candidate" && ViewData["Action"]?.ToString() == "GetCandidateByParty" ? "active" : "")">
                            <i class="fas fa-flag me-2"></i><span>All Candidate By Party</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>
        <!-- Collapsible Tenants (Multi-Tenant Management) -->
        <li class="nav-item">
            <a href="#TenantMenu" class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "SuperAdminDashboard" ? "active" : "")"
               data-bs-toggle="collapse" aria-expanded="@(ViewData["Ctrl"]?.ToString() == "SuperAdminDashboard" ? "true" : "false")" aria-label="TenantDropMenu">
                <span><i class="fas fa-building me-2"></i> Tenants</span>
                <i class="fas fa-chevron-down small"></i>
            </a>
            <div class="collapse @(ViewData["Ctrl"]?.ToString() == "SuperAdminDashboard" ? "show" : "")" id="TenantMenu">
                <ul class="nav flex-column ms-3">
                    <li class="nav-item">
                        <a asp-controller="SuperAdminDashboard" asp-action="AllTenants"
                           class="nav-link text-white @(ViewData["Action"]?.ToString() == "AllTenants" ? "active" : "")">
                            <i class="fas fa-list me-2"></i><span>All Tenants</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="SuperAdminDashboard" asp-action="GetAllPendingTenants"
                           class="nav-link text-white @(ViewData["Action"]?.ToString() == "GetAllPendingTenants" ? "active" : "")">
                            <i class="fas fa-clock me-2"></i><span>Pending Approval</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>
        <!-- Collapsible Positions -->
        <li class="nav-item">
            <a href="#PositionMenu" class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "Position" ? "active" : "")"
               data-bs-toggle="collapse" aria-expanded="false">
                <span><i class="fas fa-bullseye me-2"></i> Positions</span>
                <i class="fas fa-chevron-down small"></i>
            </a>
            <div class="collapse" id="PositionMenu">
                <ul class="nav flex-column ms-3">
                    <li class="nav-item">
                        <a asp-controller="Position" asp-action="AllPosition"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Position" && ViewData["Action"]?.ToString() == "AllPosition" ? "active" : "")">
                            <i class="fas fa-list me-2"></i><span>All Positions</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Position" asp-action="CreatePosition"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Position" && ViewData["Action"]?.ToString() == "CreatePosition" ? "active" : "")">
                            <i class="fas fa-plus-circle me-2"></i><span>Create</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <li class="sidebar-section-label">Geography</li>

        <!-- States Menu -->
        <li class="nav-item">
            <a href="#Statedropdown" class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "State" ? "active" : "")"
               data-bs-toggle="collapse" data-bs-target="#Statedropdown" aria-expanded="false">
                <span><i class="fas fa-map-marker-alt me-2"></i>States</span>
                <i class="fas fa-chevron-down small"></i>
            </a>
            <div class="collapse" id="Statedropdown">
                <ul class="nav flex-column ms-3">
                    <li class="nav-item">
                        <a asp-controller="State" asp-action="AllState"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "State" && ViewData["Action"]?.ToString() == "AllState" ? "active" : "")">
                            <i class="fas fa-list me-2"></i><span>All States</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="StateService" asp-action="CreateState"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "StateService" && ViewData["Action"]?.ToString() == "CreateState" ? "active" : "")">
                            <i class="fas fa-plus-circle me-2"></i><span>Create State</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- LGAs Menu -->
        <li class="nav-item">
            <a href="#Lgadropdown" class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "Lga" ? "active" : "")"
               data-bs-toggle="collapse" data-bs-target="#Lgadropdown" aria-expanded="false">
                <span><i class="fas fa-city me-2"></i>LGAs</span>
                <i class="fas fa-chevron-down small"></i>
            </a>
            <div class="collapse" id="Lgadropdown">
                <ul class="nav flex-column ms-3">
                    <li class="nav-item">
                        <a asp-controller="Lga" asp-action="AllLga"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Lga" && ViewData["Action"]?.ToString() == "AllLga" ? "active" : "")">
                            <i class="fas fa-list me-2"></i><span>All LGAs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Lga" asp-action="CreateLga"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Lga" && ViewData["Action"]?.ToString() == "CreateLga" ? "active" : "")">
                            <i class="fas fa-plus-circle me-2"></i><span>Create LGA</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- Manual Entry -->
        <li class="nav-item">
            <a asp-controller="Voter" asp-action="ManualEntry"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Voter" && ViewData["Action"]?.ToString() == "ManualEntry" ? "active" : "")">
                <i class="fas fa-file-invoice me-2"></i><span>Manual Entry</span>
            </a>
        </li>

        <!-- Collapsible Voters & System Audit -->
        <li class="nav-item">
            <a href="#VoterSystemMenu"
               class="nav-link text-white d-flex align-items-center justify-content-between @(ViewData["Ctrl"]?.ToString() == "Voter" || ViewData["Ctrl"]?.ToString() == "AuditLog" ? "active" : "collapsed")"
               data-bs-toggle="collapse"
               aria-expanded="@(ViewData["Ctrl"]?.ToString() == "Voter" || ViewData["Ctrl"]?.ToString() == "AuditLog" ? "true" : "false")"
               aria-controls="VoterSystemMenu">
                <span><i class="fas fa-users-cog me-2"></i> Voters & System</span>
                <i class="fas fa-chevron-down small"></i>
            </a>
            <div class="collapse @(ViewData["Ctrl"]?.ToString() == "Voter" || ViewData["Ctrl"]?.ToString() == "AuditLog" ? "show" : "")" id="VoterSystemMenu">
                <ul class="nav flex-column ms-3">
                    <li class="nav-item">
                        <a asp-controller="Voter" asp-action="Index"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Voter" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="fas fa-users me-2"></i><span>All Elections / Voters</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Voter" asp-action="PenalizedVoters"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Voter" && ViewData["Action"]?.ToString() == "PenalizedVoters" ? "active" : "")">
                            <i class="fas fa-user-slash me-2"></i><span>Penalized Voters</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="AuditLog" asp-action="Index"
                           class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "AuditLog" && ViewData["Action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="fas fa-clipboard-list me-2"></i><span>Audit Logs</span>
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <!-- Support Service -->
        <li class="nav-item mt-2">
            <a asp-controller="Home" asp-action="GetPaginatedTicketsAsync"
               class="nav-link text-white @(ViewData["Ctrl"]?.ToString() == "Home" && ViewData["Action"]?.ToString() == "SubmitSupport" ? "active" : "")">
                <i class="fas fa-headset me-2"></i><span>Support Service</span>
            </a>
        </li>

    </ul>
</nav>
