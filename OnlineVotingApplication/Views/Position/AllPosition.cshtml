@using OnlineVotingApplication.DataTransferView
@model PaginatedListViewModel<PositionDTO>

@{
    ViewData["Title"] = "All Positions";
    Layout = "_Layout";

    // FIX: Math calculation must compare page index limits against TotalItems, not TotalPages
    int startItem = (Model.PageNumber - 1) * Model.PageSize + 1;
    int endItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems);
    if (Model.TotalItems == 0) { startItem = 0; endItem = 0; }

    // Dynamic page count calculator
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
}

<div class="container mt-4">
    @await Html.PartialAsync("_Alerts")

    <div class="card shadow-sm border-0 rounded-3">
        <!-- FIXED: Removed trailing nesting bugs from header scope -->
        <div class="card-header bg-black text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-id-badge me-2"></i>Active Positions
            </h5>
            <a asp-action="CreatePosition" class="btn btn-sm btn-lightfw-bold">
                <i class="fas fa-plus"></i> Add New
            </a>
        </div>

        <!-- FIXED: Card body now sits correctly outside the card-header div -->
        <div class="card-body p-0">
            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-folder-x display-5 d-block mb-2"></i>
                    <span>No active records found for this page window index.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th scope="col" class="ps-3">Position Name</th>
                                <th scope="col" class="text-end pe-3" style="width: 250px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <!-- FIXED: Cleaned up duplicate <td> tag syntax nesting bugs -->
                                    <td class="ps-3">
                                        <span class="badge bg-light text-dark border p-2 fs-6">@item.Name</span>
                                    </td>
                                    <td class="pe-3">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <!-- EDIT ACTION BUTTON -->
                                            <a asp-action="EditPosition" asp-route-id="@item.Id"
                                               class="btn btn-outline-warning btn-sm d-flex align-items-center justify-content-center gap-1">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>

                                            <!-- SOFT-DELETE ACTION FORM -->
                                            <form asp-action="ConfirmSoftDelete" method="post" class="m-0"
                                                  onsubmit="return confirm('⚠️ SOFT-DELETE CONFIRMATION:\n\nAre you sure you want to move @item.Name to the Trash Bin?\n\nYou will have 30 days to restore this profile before it is automatically destroyed.');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="candidateId" value="@item.Id" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                                <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center justify-content-center gap-1">
                                                    <i class="bi bi-trash3-fill"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ADDED: Clean Bootstrap 5 Data Pagination Footer Control Module -->
        @if (Model.TotalItems > 0)
        {
            <div class="card-footer bg-white border-top d-flex flex-column flex-sm-row justify-content-between align-items-center py-3 gap-3">
                <!-- Text index showing location summary context boundaries -->
                <div class="text-muted small">
                    Showing <strong>@startItem</strong> to <strong>@endItem</strong> of <strong>@Model.TotalItems</strong> entries
                </div>

                <nav aria-label="Position list page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- PREVIOUS BUTTON -->
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="AllPosition"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-pageSize="@Model.PageSize">
                                Previous
                            </a>
                        </li>

                        <!-- DYNAMIC INDIVIDUAL PAGE LINKS -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" asp-action="AllPosition"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- NEXT BUTTON -->
                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="AllPosition"
                      
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-pageSize="@Model.PageSize">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
