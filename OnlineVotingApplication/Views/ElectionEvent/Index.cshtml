@model OnlineVotingApplication.DataTransferView.PaginatedListViewModel<OnlineVotingApplication.DataTransferView.ElectionViewModel>
@{
    ViewData["Title"] = "Elections";
    int totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize) : 1;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="mb-1 fw-bold" style="color:#111e3c;">
            <i class="fas fa-calendar-alt me-2" style="color:#f5a623;"></i>Elections
        </h2>
        <p class="text-muted mb-0">Every contest running on the platform, at a glance.</p>
    </div>
    <a asp-action="Create" class="btn fw-semibold text-dark" style="background:#f5a623;">
        <i class="fas fa-plus-circle me-1"></i> New Election
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by title..." />
        </div>
    </div>
    <div class="col-md-4">
        <select name="category" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in Enum.GetValues(typeof(OnlineVotingApplication.Enums.TenantCategory)))
            {
                <option value="@cat" selected="@(ViewBag.Category != null && ViewBag.Category.ToString() == cat.ToString())">@cat</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-grid">
        <button type="submit" class="btn btn-outline-secondary"><i class="fas fa-filter me-1"></i> Apply Filters</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead style="background:#111e3c;color:#fff;">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Tenant</th>
                    <th>Window</th>
                    <th>Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                            No elections match your filters yet.
                        </td>
                    </tr>
                }
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@e.Title</td>
                        <td><span class="badge bg-secondary">@e.Category</span></td>
                        <td class="text-muted">@e.TenantName</td>
                        <td class="small text-muted">
                            @e.StartDate.ToString("MMM d, yyyy") <i class="fas fa-arrow-right mx-1"></i> @e.EndDate.ToString("MMM d, yyyy")
                        </td>
                        <td>
                            @if (e.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-circle pulse-dot me-1" style="font-size:.5rem;"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">Inactive</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <a asp-controller="Candidate" asp-action="CreateCandidate" asp-route-electionEventId="@e.Id"
                               class="btn btn-sm btn-outline-primary" title="Add candidate">
                                <i class="fas fa-user-plus"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                <i class="fas fa-pen"></i>
                            </a>
                            <form asp-action="SoftDelete" asp-route-id="@e.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Move &quot;@e.Title&quot; to trash?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@p" asp-route-pageSize="@Model.PageSize"
                       asp-route-search="@ViewBag.Search" asp-route-category="@ViewBag.Category">@p</a>
                </li>
            }
        </ul>
    </nav>
}
