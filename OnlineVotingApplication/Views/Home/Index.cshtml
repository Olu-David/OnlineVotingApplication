@{
    ViewData["Title"] = "VoteZy — Vote with confidence";
}

<section class="home-hero">
    <div class="container">
        <div class="home-hero-grid">

            <div class="home-hero-copy">
                <span class="home-eyebrow">Secure &middot; Verified &middot; Counted</span>
                <h1 class="home-headline">Every vote gets a stub.<br />Every stub gets counted.</h1>
                <p class="home-sub">
                    VoteX brings the paper-trail confidence of a physical ballot to an online election —
                    register once, verify who you are, and cast a vote you can track from booth to tally.
                </p>
                <div class="home-cta-row">
                    <a asp-controller="AuthService" asp-action="UserRegistration" class="btn home-btn-primary">
                        Register to vote
                    </a>
                    <a asp-controller="Results" asp-action="LiveCount" class="btn home-btn-ghost">
                        <span class="pulse-dot">&#9679;</span> View live results
                    </a>
                </div>
            </div>

            <div class="home-hero-visual">
                <div class="ballot-stub">
                    <div class="ballot-stub-top">
                        <span class="ballot-stub-label">Counterfoil No.</span>
                        <span class="ballot-stub-no">04213</span>
                    </div>
                    <div class="ballot-stub-tear"></div>
                    <div class="ballot-stub-bottom">
                        <div class="ballot-stat">
                            <span class="ballot-stat-value">@ViewBag.ElectionCount</span>
                            <span class="ballot-stat-label">Votes cast today</span>
                        </div>
                        <div class="ballot-stat">
                            <span class="ballot-stat-value">3</span>
                            <span class="ballot-stat-label">Elections open now</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="home-steps">
    <div class="container">
        <h2 class="home-section-title">How it works</h2>
        <ol class="home-steps-list">
            <li>
                <span class="home-step-no">01</span>
                <div>
                    <h3>Register</h3>
                    <p>Create your voter profile with the details your local election office already has on file.</p>
                </div>
            </li>
            <li>
                <span class="home-step-no">02</span>
                <div>
                    <h3>Verify</h3>
                    <p>Confirm your identity so your ballot can only ever be cast once, by you.</p>
                </div>
            </li>
            <li>
                <span class="home-step-no">03</span>
                <div>
                    <h3>Vote</h3>
                    <p>Choose your candidates and submit. Your stub number lets you confirm it was received.</p>
                </div>
            </li>
        </ol>
    </div>
</section>

<section class="home-trust">
    <div class="container">
        <div class="home-trust-grid">
            <div>
                <h4>One voter, one ballot</h4>
                <p>Identity verification blocks duplicate submissions before they happen.</p>
            </div>
            <div>
                <h4>Open, auditable counts</h4>
                <p>Results update live, and every tally is reviewable by election auditors.</p>
            </div>
            <div>
                <h4>Built for every device</h4>
                <p>Vote from a phone in line or a desktop at home — VoteX adapts either way.</p>
            </div>
        </div>
    </div>
</section>