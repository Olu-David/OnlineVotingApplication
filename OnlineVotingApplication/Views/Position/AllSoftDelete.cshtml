@model OnlineVotingApplication.DataTransferView.PaginatedListViewModel<OnlineVotingApplication.DataTransferView.PositionDTO>

@{
    ViewData["Title"] = "Deleted Positions (Trash)";
    Layout = "_Layout";
    var softDeletedRawList = ViewBag.SoftPositionDeletedByElection as List<OnlineVotingApplication.Models.Positions>;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-danger"><i class="fas fa-trash-alt me-2"></i>Deleted Positions</h2>
            <p class="text-muted mb-0">Review positions that have been soft-deleted from election events.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> Back to Active Positions
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Position Name</th>
                            <th class="py-3">Deleted Date</th>
                            <th class="text-end pe-4 py-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.Items == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="fas fa-trash fa-2x mb-2 d-block text-black-50"></i>
                                    No deleted positions found in the trash.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var position in Model.Items)
                            {
                                // Updated to match position.Id and handle singular Position model namespace
                                var rawMatch = softDeletedRawList?.FirstOrDefault(p => p.Id.ToString() == position.PositionId);

                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@position.Name</td>
                                    <td class="text-muted">
                                        @(rawMatch != null ? rawMatch.DeletedAt.ToString("g") : "N/A")
                                    </td>
                                    <td class="text-end pe-4">
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Soft Deleted</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>