@using Microsoft.AspNetCore.Identity
@using OnlineVotingApplication.Areas.Identity.Data
@using OnlineVotingApplication.Models
@using OnlineVotingApplication.Repository.iServices
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IElectionService ElectionService
@inject ITenantProvider TenantProvider

@{
    // ─── AUTHENTICATION & ROLE STATES ──────────────────────────────
    bool isAuth = User?.Identity?.IsAuthenticated ?? false;

    // Core Roles aligned with Controller Authorizations (SuperAdmin, Official, Auditor, Candidate, Voter)
    bool isSuperAdmin = isAuth && User!.IsInRole("SuperAdmin");
    bool isOfficial = isAuth && User!.IsInRole("Official");
    bool isAuditor = isAuth && User!.IsInRole("Auditor");
    bool isCandidate = isAuth && User!.IsInRole("Candidate");
    bool isVoter = isAuth && User!.IsInRole("Voter");

    // Platform-Level segregation (managing cross-tenant architecture, platform settings, global logs, and manual overrides)
    bool isPlatformAdmin = isSuperAdmin || isAuth && (User!.IsInRole("PlatformAdmin") || User!.IsInRole("PlatformManager"));

    // Account block protection for unauthorized roles
    bool isBlocked = isAuth && !(isSuperAdmin || isOfficial || isAuditor || isCandidate || isVoter || isPlatformAdmin);

    // Context Switched Check for Multi-Tenancy
    Guid activeTenantId = TenantProvider.GetCurrentTenantId();
    bool isContextSwitched = isSuperAdmin && activeTenantId != Guid.Empty;

    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Dashboard Controller Routing Routing Map
    string dashCtrl = isVoter ? "Voter"
                    : isOfficial ? "Official"
                    : isAuditor ? "Auditor"
                    : isPlatformAdmin ? "PlatformAdmin"
                    : isSuperAdmin ? "SuperAdmin"
                    : isCandidate ? "Candidate"
                    : "Home";

    string nameInitial = (isAuth && !string.IsNullOrEmpty(User?.Identity?.Name))
                       ? User!.Identity!.Name![0].ToString().ToUpper()
                       : "?";

    string roleBadge = isSuperAdmin ? (isContextSwitched ? "SuperAdmin (Tenant View)" : "SuperAdmin")
                     : isPlatformAdmin ? "Platform Administrator"
                     : isOfficial ? "Election Official"
                     : isAuditor ? "System Auditor"
                     : isCandidate ? "Candidate"
                     : isVoter ? "Registered Voter"
                     : "";

    string roleColor = isSuperAdmin ? "danger"
                     : isPlatformAdmin ? "dark"
                     : isOfficial ? "primary"
                     : isAuditor ? "warning"
                     : isCandidate ? "info"
                     : isVoter ? "success"
                     : "secondary";

    // Shell configuration: Platform and SuperAdmin/Official share advanced shells
    bool isAdminShell = isSuperAdmin || isOfficial || isPlatformAdmin;

    // ─── FETCH PAST ELECTIONS FOR PUBLIC FOOTER ONLY ─────────────────
    List<ElectionEvent> pastElectionsList = new();
    if (!isAdminShell && isAuth)
    {
        try
        {
            var pastResponse = await ElectionService.GetPastElectionsAsync();
            if (pastResponse != null && pastResponse.Success && pastResponse.Data != null)
            {
                pastElectionsList = pastResponse.Data;
            }
        }
        catch
        {
            // Fail silently on layout database queries to prevent crashing page views
            pastElectionsList = new();
        }
    }

    // ─── PASS DATA TO PARTIALS ─────────────────────────────────────
    ViewData["IsAuth"] = isAuth;
    ViewData["IsSuperAdmin"] = isSuperAdmin;
    ViewData["IsPlatformAdmin"] = isPlatformAdmin;
    ViewData["IsContextSwitched"] = isContextSwitched;
    ViewData["IsOfficial"] = isOfficial;
    ViewData["IsAuditor"] = isAuditor;
    ViewData["IsCandidate"] = isCandidate;
    ViewData["IsVoter"] = isVoter;
    ViewData["IsBlocked"] = isBlocked;
    ViewData["DashCtrl"] = dashCtrl;
    ViewData["Ctrl"] = ctrl;
    ViewData["Action"] = action;
    ViewData["NameInitial"] = nameInitial;
    ViewData["RoleBadge"] = roleBadge;
    ViewData["RoleColor"] = roleColor;
    ViewData["User"] = User;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")Votezy Platform</title>

    <link rel="icon" type="image/svg+xml" href="~/vote-yea-119581-3b82f6.svg" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @if (isOfficial || isContextSwitched)
    {
        <link rel="stylesheet" href="~/css/official-sidebar.css" asp-append-version="true" />
    }

    @if (isPlatformAdmin)
    {
        <link rel="stylesheet" href="~/css/platform-admin.css" asp-append-version="true" />
    }

    @if (!isAdminShell)
    {
        <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(isAdminShell ? "vx-admin-body" : "vx-public-body")">

    @if (isAdminShell)
    {
        <div class="admin-shell d-flex w-100" style="max-width: 100vw; height: 100vh; overflow: hidden;">

            <button class="sidebar-floating-toggle d-lg-none" id="sidebarMobileToggle"
                    type="button" aria-label="Toggle sidebar" aria-expanded="false" aria-controls="adminSidebar">
                <i class="fas fa-bars"></i>
            </button>
            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <!-- ─── ROLE-BASED SIDEBAR SEGREGATION ──────────────────────── -->
            @if (isPlatformAdmin)
            {
                // Platform level operators get elevated global controls & cross-tenant auditing
                @if (System.IO.File.Exists(ViewContext.HttpContext.RequestServices.GetRequiredService<Microsoft.AspNetCore.Hosting.IWebHostEnvironment>().WebRootFileProvider.GetFileInfo("_PlatformAdminSidebar.cshtml")?.PhysicalPath))
                {
                    @await Html.PartialAsync("_PlatformAdminSidebar")
                }
                else
                {
                    @await Html.PartialAsync("_SuperAdminSidebar")
                }
            }
            else if (isSuperAdmin && !isContextSwitched)
            {
                @await Html.PartialAsync("_SuperAdminSidebar")
            }
            else
            {
                @await Html.PartialAsync("_OfficialSidebar")
            }

            <div class="d-flex flex-column flex-grow-1" style="min-width: 0; height: 100vh; overflow: hidden;">

                <!-- Platform Admin Global Utility Bar (Segregated Header Strip) -->
                @if (isPlatformAdmin)
                {
                    <div class="bg-dark text-white px-4 py-2 d-flex justify-content-between align-items-center border-bottom border-secondary small">
                        <div>
                            <span class="badge bg-danger me-2"><i class="fas fa-shield-alt me-1"></i> PLATFORM CONTEXT</span>
                            <span class="text-light">Global Infrastructure Management Mode Active</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span><i class="fas fa-server text-success me-1"></i> DB: Connected (.NET 9)</span>
                            <span class="text-muted">|</span>
                            <a asp-controller="Home" asp-action="Index" class="text-info text-decoration-none"><i class="fas fa-globe me-1"></i> Public Portal</a>
                        </div>
                    </div>
                }

                <div class="flex-grow-1" style="overflow-y: auto; overflow-x: hidden; height: 100%;">
                    <main class="admin-content p-4" style="min-height: 100%; padding-bottom: 5rem !important;">
                        @await Html.PartialAsync("_Alerts")
                        @if (!isBlocked)
                        {
                            @RenderBody()
                        }
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        @await Html.PartialAsync("_Navbar")

        <main class="flex-grow-1">
            <div class="container py-4">
                @await Html.PartialAsync("_Alerts")
                @if (!isBlocked)
                {
                    @RenderBody()
                }
            </div>
        </main>

        <footer class="border-top footer text-muted py-5 bg-light">
            <div class="container">
                <div class="mb-4">
                    <h5><i class="fa fa-history text-secondary me-2"></i>Recent Concluded Elections</h5>
                    <p class="text-muted small">Explore recent polls, category positions, and archived voting history.</p>
                </div>

                <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3">
                    @if (pastElectionsList.Any())
                    {
                        foreach (var election in pastElectionsList)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm border-secondary">
                                    <div style="height: 120px; overflow: hidden; background-color: #e9ecef;" class="position-relative">
                                        @if (!string.IsNullOrEmpty(election.ImageUrl))
                                        {
                                            <img src="@election.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@election.Title" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                <i class="fa fa-image fa-2x"></i>
                                            </div>
                                        }
                                        <span class="position-absolute top-0 end-0 badge bg-dark m-1 small">Concluded</span>
                                    </div>

                                    <div class="card-body d-flex flex-column p-3">
                                        <h6 class="card-title text-dark fw-bold text-truncate mb-1" title="@election.Title">
                                            @election.Title
                                        </h6>

                                        <p class="card-text small text-primary mb-2 text-truncate" title="@election.Description">
                                            <i class="fa fa-tag me-1"></i> @(!string.IsNullOrEmpty(election.Description) ? election.Description : "General Poll")
                                        </p>

                                        <div class="mt-auto">
                                            <div class="text-muted small mb-2" style="font-size: 0.75rem;">
                                                <i class="fa fa-calendar-check me-1"></i> Ended: @election.EndDate.ToString("MMM dd, yyyy")
                                            </div>

                                            <a asp-controller="Voter" asp-action="Details" asp-route-id="@election.Id" class="btn btn-outline-dark btn-sm w-100">
                                                View Results
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <p class="text-muted small italic">No recent concluded elections found.</p>
                        </div>
                    }
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-md-6 text-center text-md-start small">
                        &copy; 2026 Votezy. All rights reserved.
                    </div>
                </div>
            </div>
        </footer>
    }

    <!-- The mobile toggle / overlay / desktop-collapse / hover-expand
         behavior for #adminSidebar all lives in site.js now. An inline
         duplicate used to live here too, attaching a SECOND click handler
         to the same toggle button — clicking it fired both handlers,
         which toggled "mobile-open" on and back off in the same click.
         That's why the sidebar felt unresponsive / scrollbar-like instead
         of sliding open properly. Removed; site.js is the only handler now. -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/alerts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>