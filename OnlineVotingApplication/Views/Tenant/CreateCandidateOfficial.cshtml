@using OnlineVotingApplication.DataTransferView;
@model ManualCandidateCreationViewModel;

@{
    ViewData["Title"] = "Create Candidate (Official)";
}

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-semibold">
                        <i class="bi bi-person-plus-fill me-2"></i>Create Candidate (Official)
                    </h5>
                </div>

                <div class="card-body p-4">

                    <!-- Validation Summary for Global/Service Errors -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <form asp-action="CreateCandidateOfficial" method="post" enctype="multipart/form-data">

                        <!-- Election Event Selection -->
                        <div class="mb-3">
                            <label asp-for="ElectionEventId" class="form-label fw-bold">Select Election Event <span class="text-danger">*</span></label>
                            <select asp-for="ElectionEventId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.OfficialElections ?? new List<object>(), "Id", "Title"))">
                                <option value="">-- Choose Election Event --</option>
                            </select>
                            <span asp-validation-for="ElectionEventId" class="text-danger small"></span>
                        </div>

                        <!-- Candidate Email -->
                        <div class="mb-3">
                            <label asp-for="CandidateEmail" class="form-label fw-bold">Candidate Email Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope-at"></i></span>
                                <input asp-for="CandidateEmail" class="form-control" placeholder="candidate@domain.com" autocomplete="off" />
                            </div>
                            <span asp-validation-for="CandidateEmail" class="text-danger small"></span>
                        </div>

                        <!-- Optional Position ID / Title -->
                        <div class="mb-3">
                            <label asp-for="PositionId" class="form-label fw-bold">Position Target</label>
                            <select asp-for="PositionId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Positions ?? new List<object>(), "Id", "Title"))">
                                <option value="">-- Select Target Position (Optional) --</option>
                            </select>
                            <span asp-validation-for="PositionId" class="text-danger small"></span>
                        </div>

                        <!-- Manifesto -->
                        <div class="mb-3">
                            <label asp-for="Manifesto" class="form-label fw-bold">Candidate Manifesto</label>
                            <textarea asp-for="Manifesto" class="form-control" rows="4" placeholder="Brief statement or goal of the candidate..."></textarea>
                            <span asp-validation-for="Manifesto" class="text-danger small"></span>
                        </div>

                        <!-- Candidate Image Upload with Preview -->
                        <div class="mb-4">
                            <label asp-for="CandidateImage" class="form-label fw-bold">Profile Photo</label>
                            <input asp-for="CandidateImage" type="file" class="form-control" id="candidateImgInput" accept="image/*" />
                            <span asp-validation-for="CandidateImage" class="text-danger small"></span>

                            <div class="mt-3 text-center d-none" id="imagePreviewContainer">
                                <img id="candidateImgPreview" src="#" alt="Candidate Preview" class="img-thumbnail rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" />
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-action="AllCandidate" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i> Register Candidate
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Image Live Preview Script
        document.getElementById('candidateImgInput')?.addEventListener('change', function (e) {
            const [file] = e.target.files;
            const previewContainer = document.getElementById('imagePreviewContainer');
            const previewImg = document.getElementById('candidateImgPreview');

            if (file) {
                previewImg.src = URL.createObjectURL(file);
                previewContainer.classList.remove('d-none');
            } else {
                previewContainer.classList.add('d-none');
            }
        });
    </script>
}