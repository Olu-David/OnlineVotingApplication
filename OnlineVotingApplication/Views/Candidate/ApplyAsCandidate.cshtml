@using System.Security.Claims
@model OnlineVotingApplication.DataTransferView.CandidateApplicationViewModel

@{
    ViewData["Title"] = "Apply as a Candidate";
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    string email = User.FindFirstValue(ClaimTypes.Email) ?? "";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary">Candidate Application</h2>
                        <p class="text-muted">Fill out the details below to express your interest in running for this election.</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="ApplyAsCandidate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ElectionEventId" />
                        <input type="hidden" asp-for="TenantId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="FirstName" class="form-control form-control-lg" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-semibold"></label>
                                <input asp-for="LastName" class="form-control form-control-lg" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            @if (isAuthenticated)
                            {
                                <input asp-for="Email" class="form-control form-control-lg" value="@email" readonly />
                            }
                            else
                            {
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                            }
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">ElectionEvent</label>
                            <input asp-for="ElectionEventId" class="form-control form-control-lg" value="@ViewBag.ElectionTitle" readonly />
                            <span asp-validation-for="SelectedPositionId" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="SelectedPositionId" class="form-label fw-semibold"></label>
                            <select asp-for="SelectedPositionId" asp-items="Model.PositionOptions" class="form-select form-select-lg">
                                <option value="">-- Choose Position --</option>
                            </select>
                            <span asp-validation-for="SelectedPositionId" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-semibold">Submit Application</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}