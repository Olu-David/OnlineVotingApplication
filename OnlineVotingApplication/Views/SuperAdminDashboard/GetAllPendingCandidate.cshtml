@model OnlineVotingApplication.DataTransferView.PaginatedListViewModel<OnlineVotingApplication.DataTransferView.CandidateViewModel>

@{
    ViewData["Title"] = "Pending Candidate Approvals";
}

<div class="container-fluid my-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">Pending Candidates Queue</h2>
            <p class="text-muted">Review and approve or reject candidate submissions.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">Candidate Name</th>
                            <th>Position</th>
                            <th>Party</th>
                            <th>Location (State / LGA)</th>
                            <th>Manifesto</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var candidate in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@candidate.Name</td>
                                    <td>@(candidate.Position ?? "N/A")</td>
                                    <td>@(candidate.PartyName ?? "Independent / N/A")</td>
                                    <td>
                                        <div>@candidate.StateName</div>
                                        <small class="text-muted">@candidate.LgaName</small>
                                    </td>
                                    <td>
                                        <span class="d-inline-block text-truncate" style="max-width: 200px;" title="@candidate.Manifesto">
                                            @candidate.Manifesto
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <!-- Approve Button -->
                                            <form asp-controller="Candidate" asp-action="ApproveCandidate" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="candidateId" value="@candidate.CandidateID" />
                                                <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Approve Candidate">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </button>
                                            </form>

                                            <!-- Reject/Delete Button -->
                                            <form asp-controller="Candidate" asp-action="RejectCandidate" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to reject and delete this nomination?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="candidateId" value="@candidate.CandidateID" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject Candidate">
                                                    <i class="bi bi-x-lg"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No pending candidate applications found in the queue.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Showing page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalItems items)
                </span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Previous Page -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="GetAllPendingCandiddate" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">
                                Previous
                            </a>
                        </li>

                        <!-- Numbered Links -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="GetAllPendingCandiddate" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Next Page -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="GetAllPendingCandiddate" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>