@model OnlineVotingApplication.DataTransferView.SuperAdminDashboardVM
@{
    ViewData["Title"] = "Super Admin Dashboard";
    Layout = "_Layout"; // Or your main admin layout
}

<div class="container-fluid py-4">
    <!-- Top Greeting & Header -->
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">
                    <i class="fas fa-shield-alt text-warning me-2"></i>Super Admin Control Center
                </h1>
                <p class="text-muted small mb-0">Manage global templates, tenant organizations, system verifications, and platform settings.</p>
            </div>
            <div>
                <span class="badge bg-danger px-3 py-2 fw-semibold shadow-sm">System Administrator</span>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Tenants Card -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted text-uppercase fw-semibold small mb-1">Active Tenants</h6>
                            <h2 class="fw-bold mb-0 text-dark">@(ViewData["ActiveTenantsCount"] ?? "—")</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="fas fa-building fa-2x"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="SuperAdminDashboard" asp-action="AllTenants" class="small text-decoration-none fw-semibold text-primary">
                            View All Organizations <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Approvals Card -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted text-uppercase fw-semibold small mb-1">Pending Approvals</h6>
                            <h2 class="fw-bold mb-0 text-dark">@(ViewData["PendingTenantsCount"] ?? "—")</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                            <i class="fas fa-clock fa-2x"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a asp-action="GetAllPendingTenants" class="small text-decoration-none fw-semibold text-warning text-dark">
                            Review Registrations <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Builder Card -->
        <div class="col-xl-4 col-md-12">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted text-uppercase fw-semibold small mb-1">Global Form Templates</h6>
                            <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-wpforms text-success"></i></h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                            <i class="fas fa-tools fa-2x"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a asp-action="BuildGlobalForm" class="small text-decoration-none fw-semibold text-success">
                            Configure Form Schema <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Panels -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-bolt text-warning me-2"></i>Quick Actions</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <a asp-action="GetAllPendingTenants" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light hover-shadow transition">
                            <div class="bg-warning text-dark p-3 rounded-3 me-3">
                                <i class="fas fa-user-check fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Approve Tenants</h6>
                                <p class="text-muted small mb-0">Evaluate new tenant signups.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-action="BuildGlobalForm" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light hover-shadow transition">
                            <div class="bg-primary text-white p-3 rounded-3 me-3">
                                <i class="fas fa-edit fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Global Form Builder</h6>
                                <p class="text-muted small mb-0">Setup dynamic voting fields.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-action="AllTenants" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light hover-shadow transition">
                            <div class="bg-success text-white p-3 rounded-3 me-3">
                                <i class="fas fa-list-alt fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Manage All Tenants</h6>
                                <p class="text-muted small mb-0">Audit organizations and switch context.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Home" asp-action="Index" class="p-3 border rounded-3 d-flex align-items-center text-decoration-none text-dark bg-light hover-shadow transition">
                            <div class="bg-secondary text-white p-3 rounded-3 me-3">
                                <i class="fas fa-globe fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Public Site</h6>
                                <p class="text-muted small mb-0">Return to VoteX main landing page.</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white h-100">
                <h5 class="fw-bold text-warning mb-3"><i class="fas fa-info-circle me-2"></i>Admin Tips</h5>
                <ul class="list-unstyled small text-light opacity-75 mb-0">
                    <li class="mb-3">
                        <i class="fas fa-check text-warning me-2"></i> Approving a tenant organization automatically provisions approval rights for its primary admin user.
                    </li>
                    <li class="mb-3">
                        <i class="fas fa-check text-warning me-2"></i> Use the <strong>Switch Context</strong> action inside the tenant lists to inspect and verify tenant-specific dashboards directly.
                    </li>
                    <li>
                        <i class="fas fa-check text-warning me-2"></i> Global form fields apply platform-wide schema rules across new election categories.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Simple subtle hover effect trigger if needed
        document.addEventListener("DOMContentLoaded", function() {
            console.log("Super Admin Dashboard initialized.");
        });
    </script>
}